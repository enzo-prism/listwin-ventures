{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/cv.js": {
      "includeFiles": "private/cv.html",
      "memory": 128,
      "maxDuration": 10
    }
  },
  "redirects": [
    {
      "source": "/:cv(CV|Cv|cV)",
      "destination": "/cv",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/cv",
      "destination": "/api/cv"
    },
    {
      "source": "/cv/",
      "destination": "/api/cv"
    },
    {
      "source": "/cv/:path*",
      "destination": "/api/cv"
    }
  ]
}

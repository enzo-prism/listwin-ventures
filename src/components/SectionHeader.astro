---
// Legacy API kept for older pages; renders the new SectionHeading styling.
import SectionHeading from './SectionHeading.astro';

interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
  class?: string;
}

const { eyebrow, title, description, align = 'left', class: className = '' } = Astro.props;
---

<SectionHeading eyebrow={eyebrow} title={title} description={description} align={align} size="sm" class={className} />

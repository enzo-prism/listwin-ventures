---
import Icon from './Icon.astro';

interface NavLeaf {
  label: string;
  href: string;
  description?: string;
  icon?: string;
}

interface NavSection {
  label: string;
  items: NavLeaf[];
}

interface NavMenu {
  label: string;
  href?: string;
  icon?: string;
  /** Rendered in the mobile drawer only (the logo already links home on desktop). */
  mobileOnly?: boolean;
  sections?: NavSection[];
}

export interface Props {
  items: NavMenu[];
  contactHref: string;
  currentPath?: string;
}

const { items, contactHref, currentPath = '/' } = Astro.props;

const isCurrent = (href?: string) =>
  Boolean(href) && (href === '/' ? currentPath === '/' : currentPath === href || currentPath.startsWith(`${href}/`));
const groupIsCurrent = (item: NavMenu) =>
  item.sections?.some((section) => section.items.some((leaf) => isCurrent(leaf.href))) ?? false;
---

<nav class="site-nav flex items-center gap-1" aria-label="Primary">
  <!-- Desktop: CSS-driven hover/focus dropdowns, no JavaScript required for open/close. -->
  <ul class="hidden items-center gap-0.5 lg:flex">
    {items.filter((item) => !item.mobileOnly).map((item) => {
      if (!item.sections?.length && item.href) {
        return (
          <li>
            <a
              href={item.href}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
              class="nav-link inline-flex items-center rounded-full px-3.5 py-2 text-[0.9rem] font-medium text-foreground/70 transition-colors hover:bg-muted hover:text-foreground aria-[current=page]:text-foreground"
            >
              {item.label}
            </a>
          </li>
        );
      }

      const wide = (item.sections?.length ?? 0) > 1;
      return (
        <li class="nav-group relative">
          <button
            type="button"
            class:list={[
              'nav-trigger inline-flex items-center gap-1.5 rounded-full bg-transparent px-3.5 py-2 text-[0.9rem] font-medium text-foreground/70 transition-colors hover:bg-muted hover:text-foreground',
              groupIsCurrent(item) && 'text-foreground',
            ]}
            aria-expanded="false"
            aria-haspopup="true"
          >
            {item.label}
            <Icon name="chevron-down" size={14} class="nav-caret text-foreground/40 transition-transform duration-300" />
          </button>
          <div class="nav-panel absolute right-0 top-full pt-3">
            <div
              class:list={[
                'nav-card rounded-3xl border border-border bg-card p-2 shadow-[var(--shadow-panel)]',
                wide ? 'grid w-max max-w-[min(760px,calc(100vw-4rem))] grid-cols-3 gap-1' : 'w-80',
              ]}
            >
              {item.sections?.map((section) => (
                <div class="rounded-2xl p-3">
                  <p class="mb-2 px-2 font-mono text-[0.65rem] uppercase tracking-[0.16em] text-muted-foreground">{section.label}</p>
                  <div class="space-y-0.5">
                    {section.items.map((leaf) => (
                      <a
                        href={leaf.href}
                        aria-current={isCurrent(leaf.href) ? 'page' : undefined}
                        class="group/leaf flex items-start gap-3 rounded-xl px-2 py-2 text-sm text-foreground/80 transition-colors hover:bg-muted hover:text-foreground aria-[current=page]:bg-muted"
                      >
                        {leaf.icon && (
                          <span class="mt-0.5 grid size-8 shrink-0 place-items-center rounded-lg border border-border bg-background text-muted-foreground transition-colors group-hover/leaf:border-primary/40 group-hover/leaf:text-primary">
                            <Icon name={leaf.icon} size={16} />
                          </span>
                        )}
                        <span class="min-w-0">
                          <span class="block font-medium leading-snug">{leaf.label}</span>
                          {leaf.description && (
                            <span class="mt-0.5 block text-xs leading-snug text-muted-foreground">{leaf.description}</span>
                          )}
                        </span>
                      </a>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </div>
        </li>
      );
    })}
    <li class="pl-2">
      <a href={contactHref} class="btn btn-primary btn-sm">
        Contact
        <Icon name="arrow-right" size={15} class="arrow" />
      </a>
    </li>
  </ul>

  <!-- Mobile: native <details> drawer + <details> accordions. Fully functional with JS disabled. -->
  <details class="mobile-drawer lg:hidden">
    <summary
      class="inline-flex h-10 cursor-pointer list-none items-center gap-2 rounded-full border border-border bg-card px-4 text-sm font-medium text-foreground [&::-webkit-details-marker]:hidden"
      aria-controls="mobile-navigation-panel"
    >
      <Icon name="menu" size={16} class="drawer-open-icon" />
      <Icon name="x" size={16} class="drawer-close-icon" />
      Menu
    </summary>
    <div class="mobile-backdrop" aria-hidden="true"></div>
    <div
      id="mobile-navigation-panel"
      class="mobile-panel"
      role="dialog"
      aria-labelledby="mobile-navigation-title"
    >
      <div class="flex items-center justify-between px-5 pb-3 pt-4">
        <span id="mobile-navigation-title" class="font-mono text-[0.7rem] uppercase tracking-[0.18em] text-muted-foreground">
          Navigation
        </span>
        <button
          type="button"
          class="hidden size-10 items-center justify-center rounded-full border border-border bg-card text-foreground transition hover:bg-muted"
          aria-label="Close navigation menu"
          data-mobile-close
        >
          <Icon name="x" size={18} />
        </button>
      </div>
      <div class="flex-1 space-y-1 overflow-y-auto overscroll-contain px-3 pb-6">
        {items.map((item, index) => {
          if (!item.sections?.length && item.href) {
            return (
              <a
                href={item.href}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
                class="mobile-item flex items-center justify-between rounded-2xl px-3 py-3 font-display text-[1.75rem] leading-none text-foreground"
                style={`--i:${index}`}
              >
                {item.label}
                <Icon name="arrow-up-right" size={18} class="text-muted-foreground" />
              </a>
            );
          }

          return (
            <details class="mobile-section mobile-item rounded-2xl" style={`--i:${index}`}>
              <summary class="flex cursor-pointer list-none items-center justify-between gap-2 rounded-2xl px-3 py-3 font-display text-[1.75rem] leading-none text-foreground [&::-webkit-details-marker]:hidden">
                {item.label}
                <Icon name="plus" size={18} class="mobile-caret text-muted-foreground transition-transform duration-300" />
              </summary>
              <div class="space-y-4 px-3 pb-4 pt-1">
                {item.sections?.map((section) => (
                  <div>
                    <p class="mb-1.5 font-mono text-[0.62rem] uppercase tracking-[0.18em] text-muted-foreground">{section.label}</p>
                    <div class="grid gap-0.5">
                      {section.items.map((leaf) => (
                        <a
                          href={leaf.href}
                          aria-current={isCurrent(leaf.href) ? 'page' : undefined}
                          class="flex items-center gap-3 rounded-xl px-2 py-2 text-[0.95rem] text-foreground/80 transition-colors hover:bg-muted hover:text-foreground aria-[current=page]:text-primary"
                        >
                          {leaf.icon && <Icon name={leaf.icon} size={16} class="text-muted-foreground" />}
                          {leaf.label}
                        </a>
                      ))}
                    </div>
                  </div>
                ))}
              </div>
            </details>
          );
        })}
      </div>
      <div class="border-t border-border px-5 pb-[max(1.25rem,env(safe-area-inset-bottom))] pt-4">
        <a href={contactHref} class="btn btn-primary w-full">
          Contact
          <Icon name="arrow-right" size={16} class="arrow" />
        </a>
      </div>
    </div>
  </details>
</nav>

<style>
  /* Desktop dropdown: hidden by default, revealed on hover or keyboard focus within the group.
     No JavaScript is required for this to work. */
  /* Closed panels use display:none so their wide box never contributes to document width
     (a visibility:hidden panel is still laid out and would create horizontal overflow). */
  .nav-panel {
    display: none;
    z-index: 50;
  }
  .nav-group:hover > .nav-panel,
  .nav-group:focus-within > .nav-panel {
    display: block;
    animation: lv-nav-in 360ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  @keyframes lv-nav-in {
    from {
      opacity: 0;
      transform: translateY(-6px) scale(0.98);
      filter: blur(4px);
    }
    to {
      opacity: 1;
      transform: none;
      filter: none;
    }
  }
  .nav-card {
    transform-origin: top right;
  }
  .nav-group:hover > .nav-trigger .nav-caret,
  .nav-group:focus-within > .nav-trigger .nav-caret {
    transform: rotate(180deg);
  }

  /* Mobile drawer via <details>. Icons swap on open; a fixed sheet slides in from the right. */
  .mobile-drawer > summary .drawer-close-icon {
    display: none;
  }
  .mobile-drawer[open] > summary .drawer-open-icon {
    display: none;
  }
  .mobile-drawer[open] > summary .drawer-close-icon {
    display: inline-block;
  }

  .mobile-backdrop {
    display: none;
  }
  .mobile-drawer[open] .mobile-backdrop {
    position: fixed;
    inset: 0;
    display: block;
    background: color-mix(in oklab, var(--foreground) 22%, transparent);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    z-index: 45;
    animation: lv-fade-in 300ms ease;
  }
  @keyframes lv-fade-in {
    from {
      opacity: 0;
    }
  }

  /* A backdrop-filter makes an ancestor the containing block for fixed descendants in
     Chromium. Temporarily remove the sticky header blur so the open drawer and backdrop
     are fixed to the viewport instead of being clipped to the header. */
  :global(header:has(.mobile-drawer[open])) {
    -webkit-backdrop-filter: none !important;
    backdrop-filter: none !important;
    z-index: 60;
  }

  /* Without JavaScript, the native summary remains the drawer's close control. Move it
     above the viewport-sized panel so keyboard and pointer users cannot get trapped. */
  :global(html:not(.nav-enhanced) header:has(.mobile-drawer[open]) .mobile-drawer > summary) {
    position: fixed;
    inset-block-start: 0.8rem;
    inset-inline-end: 1rem;
    z-index: 47;
  }

  /* Rendered only while the drawer is open. An explicit display on the closed panel would
     override the native <details> hiding and leave a fixed element off-screen to the right,
     which creates horizontal overflow on mobile. */
  .mobile-panel {
    position: fixed;
    inset-block: 0;
    inset-inline-end: 0;
    width: min(100vw, 26rem);
    background: var(--background);
    border-inline-start: 1px solid var(--border);
    box-shadow: -30px 0 80px -20px rgb(0 0 0 / 0.25);
    z-index: 46;
    display: none;
  }
  .mobile-drawer[open] .mobile-panel {
    display: flex;
    flex-direction: column;
    animation: lv-drawer-in 480ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .mobile-drawer[open] .mobile-item {
    animation: lv-item-in 600ms cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: calc(var(--i, 0) * 45ms + 80ms);
  }
  @keyframes lv-drawer-in {
    from {
      transform: translateX(100%);
    }
    to {
      transform: translateX(0);
    }
  }
  @keyframes lv-item-in {
    from {
      opacity: 0;
      transform: translateX(18px);
    }
  }

  .mobile-section[open] .mobile-caret {
    transform: rotate(45deg);
  }
  .mobile-section[open] {
    background: var(--muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-group:hover > .nav-panel,
    .nav-group:focus-within > .nav-panel,
    .mobile-drawer[open] .mobile-panel,
    .mobile-drawer[open] .mobile-item,
    .mobile-drawer[open] .mobile-backdrop {
      animation: none;
    }
  }
</style>

<script is:inline>
  // Progressive enhancement only — the nav is fully usable without this.
  // 1) keep aria-expanded in sync on the desktop triggers; 2) close the mobile drawer and any
  // open desktop menu on Escape or an outside click; 3) make the mobile drawer modal by
  // containing focus, returning it to the trigger, and making the background inert.
  (() => {
    document.documentElement.classList.add('nav-enhanced');

    const groups = Array.from(document.querySelectorAll('.nav-group'));
    groups.forEach((group) => {
      const trigger = group.querySelector('.nav-trigger');
      if (!trigger) return;
      const sync = () => {
        const open = group.matches(':hover') || group.contains(document.activeElement);
        trigger.setAttribute('aria-expanded', open ? 'true' : 'false');
      };
      group.addEventListener('mouseenter', sync);
      group.addEventListener('mouseleave', sync);
      group.addEventListener('focusin', sync);
      group.addEventListener('focusout', () => window.setTimeout(sync, 0));
    });

    const drawer = document.querySelector('.mobile-drawer');
    if (drawer) {
      const trigger = drawer.querySelector(':scope > summary');
      const panel = drawer.querySelector('.mobile-panel');
      const closeButton = drawer.querySelector('[data-mobile-close]');
      const inertedSiblings = [];
      let savedBodyOverflow = '';
      let bodyLocked = false;

      if (trigger) {
        trigger.setAttribute('aria-expanded', 'false');
        trigger.setAttribute('aria-label', 'Open navigation menu');
      }
      if (closeButton) closeButton.classList.remove('hidden');

      const focusableSelector = [
        'a[href]',
        'button:not([disabled])',
        'input:not([disabled])',
        'select:not([disabled])',
        'textarea:not([disabled])',
        'summary',
        '[tabindex]:not([tabindex="-1"])',
      ].join(',');

      const getFocusableElements = () => {
        if (!panel) return [];
        return Array.from(panel.querySelectorAll(focusableSelector)).filter(
          (element) =>
            element instanceof HTMLElement &&
            !element.closest('[inert]') &&
            element.getClientRects().length > 0,
        );
      };

      const setBodyLock = (locked) => {
        if (locked && !bodyLocked) {
          savedBodyOverflow = document.body.style.overflow;
          document.body.style.overflow = 'hidden';
          bodyLocked = true;
        } else if (!locked && bodyLocked) {
          document.body.style.overflow = savedBodyOverflow;
          bodyLocked = false;
        }
      };

      // Inert every sibling outside the branch that contains the drawer. This handles the
      // header logo, page content, footer, cookie banner, and skip link without coupling the
      // component to a particular page layout.
      const setBackgroundInert = (inert) => {
        if (!inert) {
          inertedSiblings.splice(0).forEach(({ element, wasInert }) => {
            element.inert = wasInert;
          });
          return;
        }

        let branch = drawer;
        while (branch && branch !== document.body) {
          const parent = branch.parentElement;
          if (!parent) break;
          Array.from(parent.children).forEach((sibling) => {
            if (sibling === branch || !(sibling instanceof HTMLElement)) return;
            inertedSiblings.push({ element: sibling, wasInert: sibling.inert });
            sibling.inert = true;
          });
          branch = parent;
        }
      };

      const syncDrawerState = (open) => {
        if (trigger) {
          trigger.setAttribute('aria-expanded', open ? 'true' : 'false');
          trigger.setAttribute('aria-label', open ? 'Close navigation menu' : 'Open navigation menu');
        }
        if (panel) {
          if (open) panel.setAttribute('aria-modal', 'true');
          else panel.removeAttribute('aria-modal');
        }
        setBodyLock(open);
        setBackgroundInert(open);

        if (open) {
          // Wait until the newly displayed panel has completed layout before moving focus.
          window.requestAnimationFrame(() => {
            if (!drawer.open) return;
            (closeButton || getFocusableElements()[0])?.focus();
          });
        } else if (trigger instanceof HTMLElement && document.contains(trigger)) {
          trigger.focus();
        }
      };

      const closeDrawer = () => {
        if (!drawer.open) return;
        drawer.removeAttribute('open');
        // The native toggle event is queued. Restore interaction synchronously so Escape,
        // backdrop dismissal, and responsive resizing cannot briefly leave the page inert.
        syncDrawerState(false);
      };

      drawer.addEventListener('toggle', () => syncDrawerState(drawer.open));

      const backdrop = drawer.querySelector('.mobile-backdrop');
      if (backdrop) backdrop.addEventListener('click', closeDrawer);
      if (closeButton) closeButton.addEventListener('click', closeDrawer);

      // Close the drawer after tapping a navigation link.
      drawer.querySelectorAll('.mobile-panel a').forEach((link) => {
        link.addEventListener('click', closeDrawer);
      });

      // A responsive resize must not leave an invisible open drawer locking the desktop page.
      const desktopMedia = window.matchMedia('(min-width: 1024px)');
      desktopMedia.addEventListener('change', (event) => {
        if (event.matches && drawer.open) closeDrawer();
      });

      document.addEventListener('keydown', (event) => {
        if (!drawer.open) return;

        if (event.key === 'Tab') {
          const focusable = getFocusableElements();
          event.preventDefault();
          if (!focusable.length) {
            return;
          }

          const active = document.activeElement;
          const activeIndex = focusable.indexOf(active);
          const nextIndex = event.shiftKey
            ? activeIndex <= 0
              ? focusable.length - 1
              : activeIndex - 1
            : activeIndex < 0 || activeIndex === focusable.length - 1
              ? 0
              : activeIndex + 1;
          focusable[nextIndex].focus();
          return;
        }

        if (event.key === 'Escape') {
          event.preventDefault();
          closeDrawer();
        }
      });
    }

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      if (drawer && drawer.open) return;
      const active = document.activeElement;
      if (active && active.closest && active.closest('.nav-group')) active.blur();
    });
  })();
</script>

---
interface Props {
  id?: string;
  tone?: 'default' | 'muted' | 'brand';
  class?: string;
}

const { id, tone = 'default', class: className = '' } = Astro.props;

const toneMap = {
  default: 'bg-card',
  muted: 'bg-muted',
  brand: 'bg-accent',
} as const;
---

<section id={id} class={`card-lv space-y-6 p-6 sm:p-10 ${toneMap[tone]} ${className}`.trim()} data-reveal>
  <slot />
</section>

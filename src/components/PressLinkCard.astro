---
import Icon from './Icon.astro';
import { formatPressPublished, isExternalUrl, type PressItem, type PressKind } from '../data/press';

type PressLinkCardVariant = 'featured' | 'standard' | 'related';

const {
  item,
  variant = 'standard',
  showTags = variant !== 'related',
  showQuote = variant === 'featured',
  ctaLabel,
} = Astro.props as {
  item: PressItem;
  variant?: PressLinkCardVariant;
  showTags?: boolean;
  showQuote?: boolean;
  ctaLabel?: string;
};

const kindLabels: Record<PressKind, string> = {
  article: 'Article',
  interview: 'Interview',
  'press-release': 'Press release',
  video: 'Video',
  reference: 'Reference',
};

const kindIcons: Record<PressKind, string> = {
  article: 'newspaper',
  interview: 'mic',
  'press-release': 'megaphone',
  video: 'play',
  reference: 'link',
};

const icon = kindIcons[item.kind] ?? 'link';
const kindLabel = kindLabels[item.kind] ?? 'Link';
const published = formatPressPublished(item);
const external = isExternalUrl(item.url);
const resolvedCtaLabel = ctaLabel ?? (item.kind === 'reference' ? 'Open link' : 'Read');
const visibleTags = showTags ? (item.tags ?? []).slice(0, variant === 'featured' ? 4 : 3) : [];
const titleClass = variant === 'featured' ? 'display-sm' : 'text-xl font-medium leading-snug tracking-[-0.01em]';
---

<article class="press-card group card-lv card-hover spotlight relative flex h-full flex-col p-6 sm:p-7">
  <div class="flex flex-wrap items-center justify-between gap-2">
    <span class="chip">
      <Icon name={icon} size={13} />
      {kindLabel}
    </span>
    <p class="font-mono text-[0.7rem] uppercase tracking-[0.1em] text-muted-foreground">
      {item.publisher}
      {published ? ` · ${published}` : ''}
    </p>
  </div>

  <div class="mt-5 flex-1 space-y-3">
    <h3 class={`text-foreground ${titleClass}`}>
      <a
        href={item.url}
        target={external ? '_blank' : undefined}
        rel={external ? 'noopener noreferrer' : undefined}
        class="stretched-link transition-colors group-hover:text-primary"
      >
        {item.title}
      </a>
    </h3>
    <p class="text-[0.95rem] leading-relaxed text-muted-foreground">{item.summary}</p>
    {showQuote && item.quote && (
      <blockquote class="border-l-2 border-primary/50 pl-4 font-display text-lg italic leading-snug text-foreground/85">
        “{item.quote}”
      </blockquote>
    )}
  </div>

  <div class="mt-6 flex flex-wrap items-center justify-between gap-3">
    <div class="flex flex-wrap gap-1.5">
      {visibleTags.map((tag) => (
        <span class="rounded-full bg-muted px-2.5 py-1 text-[0.7rem] font-medium text-muted-foreground">{tag}</span>
      ))}
    </div>
    <span class="inline-flex items-center gap-1.5 text-sm font-medium text-foreground/80 transition-colors group-hover:text-primary" aria-hidden="true">
      {resolvedCtaLabel}
      <Icon name={external ? 'arrow-up-right' : 'arrow-right'} size={15} class="transition-transform duration-500 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
    </span>
  </div>
</article>

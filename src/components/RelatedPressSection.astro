---
import Icon from './Icon.astro';
import PressLinkCard from './PressLinkCard.astro';
import SectionHeading from './SectionHeading.astro';
import type { PressItem } from '../data/press';

const {
  items,
  title = 'Related reading',
  eyebrow = 'References',
  viewAllHref = '/press',
  viewAllLabel = 'View all press',
  countNote,
} = Astro.props as {
  items: PressItem[];
  title?: string;
  eyebrow?: string;
  viewAllHref?: string;
  viewAllLabel?: string;
  countNote?: string;
};
---

{items.length > 0 && (
  <section class="related-press container-lv section-tight">
    <SectionHeading eyebrow={eyebrow} title={title} description={countNote} size="sm">
      <a class="btn btn-secondary btn-sm" href={viewAllHref}>
        {viewAllLabel}
        <Icon name="arrow-right" size={14} class="arrow" />
      </a>
    </SectionHeading>

    <div class="mt-10 grid gap-4 md:grid-cols-2" data-reveal-stagger="80">
      {items.map((item) => (
        <div data-reveal>
          <PressLinkCard item={item} variant="related" />
        </div>
      ))}
    </div>
  </section>
)}

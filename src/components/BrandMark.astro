---
// The Listwin Ventures mark: the original logo's slanted green bar, redrawn as SVG so it stays
// crisp and follows the active theme. The wordmark is live text (no black-on-dark PNG problem).
interface Props {
  class?: string;
  compact?: boolean;
}
const { class: className = '', compact = false } = Astro.props;
---

<span class={`brand-mark inline-flex items-center gap-2.5 ${className}`.trim()}>
  <svg viewBox="0 0 30 32" width="24" height="26" aria-hidden="true" class="shrink-0 overflow-visible">
    <path d="M9 0h12l-9 32H0z" fill="var(--primary)" class="brand-bar" />
    <path d="M24.5 6h5.5l-6.8 26h-5.4z" fill="currentColor" opacity="0.28" class="brand-bar-2" />
  </svg>
  {!compact && (
    <span class="flex flex-col leading-none">
      <span class="font-display text-[1.35rem] leading-[0.9] tracking-[-0.01em]">Listwin</span>
      <span class="mt-[3px] font-mono text-[0.56rem] uppercase tracking-[0.32em] text-muted-foreground">Ventures</span>
    </span>
  )}
</span>

<style>
  .brand-bar,
  .brand-bar-2 {
    transition: transform 600ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  :global(a:hover) > .brand-mark .brand-bar {
    transform: translateX(1.5px);
  }
  :global(a:hover) > .brand-mark .brand-bar-2 {
    transform: translateX(-1px);
  }
</style>

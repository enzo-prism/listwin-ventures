---
// The original Listwin Ventures logo. Its "LISTWIN/VENTURES" text and grey "V" are dark on a
// transparent background, so dark mode swaps in listwin-ventures-logo-dark.webp: the same file
// with only the black/grey pixels lightened (the green bar and "L/" are untouched).
interface Props {
  class?: string;
  loading?: 'eager' | 'lazy';
}
const { class: className = 'h-10', loading = 'eager' } = Astro.props;
---

<span class="brand-mark inline-flex items-center">
  <img
    src="/assets/media/listwin-ventures-logo.webp"
    alt="Listwin Ventures"
    width="300"
    height="120"
    loading={loading}
    decoding="async"
    class={`brand-logo-light w-auto ${className}`}
  />
  <img
    src="/assets/media/listwin-ventures-logo-dark.webp"
    alt="Listwin Ventures"
    width="300"
    height="120"
    loading={loading}
    decoding="async"
    class={`brand-logo-dark w-auto ${className}`}
  />
</span>

<style>
  .brand-logo-dark {
    display: none;
  }
  :global(.dark) .brand-logo-light {
    display: none;
  }
  :global(.dark) .brand-logo-dark {
    display: block;
  }
  img {
    transition: opacity 300ms;
  }
  :global(a:hover) > .brand-mark img {
    opacity: 0.8;
  }
</style>

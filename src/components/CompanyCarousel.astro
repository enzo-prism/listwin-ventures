---
import type { EntityDetail } from '../data/entityDetails';
import { getDetailPath } from '../data/entityDetails';
import Icon from './Icon.astro';
import { darkPlateLogoIds } from '../lib/logos';

export interface Props {
  title?: string;
  items: EntityDetail[];
  hideImages?: boolean;
}

const { title, items, hideImages = false } = Astro.props;
---

{items.length > 0 && (
  <section class="space-y-4">
    {title && <h3 class="font-mono text-xs uppercase tracking-[0.16em] text-muted-foreground">{title}</h3>}
    <div role="list" class="-mx-1 flex snap-x snap-mandatory gap-4 overflow-x-auto px-1 pb-4 pt-1 [scrollbar-width:thin]">
      {items.map((item) => (
        <article role="listitem" class="group card-lv card-hover spotlight relative flex w-[17rem] shrink-0 snap-start flex-col overflow-hidden p-2">
          {!hideImages && (
            <span class:list={['logo-plate h-24 px-6', darkPlateLogoIds.has(item.slug) && 'is-dark']}>
              <img src={item.asset.path} alt={item.asset.alt} width="320" height="128" loading="lazy" decoding="async" class="max-h-11 w-auto max-w-[78%]" />
            </span>
          )}
          <div class="flex flex-1 flex-col gap-1.5 p-3">
            <a href={getDetailPath(item.slug)} class="stretched-link font-medium text-foreground">{item.name}</a>
            <p class="line-clamp-3 text-sm leading-relaxed text-muted-foreground">{item.summary}</p>
            <span class="mt-auto inline-flex items-center gap-1 pt-2 text-sm font-medium text-foreground/80 group-hover:text-primary">
              View detail <Icon name="arrow-right" size={14} />
            </span>
          </div>
        </article>
      ))}
    </div>
  </section>
)}

---
import type { VisualAsset } from '../data/assets';
import LogoTile from './LogoTile.astro';

export interface Props {
  title?: string;
  assets: VisualAsset[];
  columns?: number;
}

const { title, assets, columns = 4 } = Astro.props;
const lgCols: Record<number, string> = {
  2: 'lg:grid-cols-2',
  3: 'lg:grid-cols-3',
  4: 'lg:grid-cols-4',
  5: 'lg:grid-cols-5',
  6: 'lg:grid-cols-6',
};
---

<section class="space-y-5">
  {title && <h3 class="font-mono text-xs uppercase tracking-[0.16em] text-muted-foreground">{title}</h3>}
  <div class={`grid grid-cols-2 gap-3 sm:grid-cols-3 ${lgCols[Math.min(Math.max(columns, 2), 6)] ?? 'lg:grid-cols-4'}`} data-reveal-stagger="50">
    {assets.map((asset) => (
      <div data-reveal>
        <LogoTile asset={asset} size="sm" class="h-full" />
      </div>
    ))}
  </div>
</section>

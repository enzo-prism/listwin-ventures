---
import '../styles/global.css';
import SiteNavigation from '../components/SiteNavigation.astro';
import SharePanel from '../components/SharePanel.astro';
import BrandMark from '../components/BrandMark.astro';
import Icon from '../components/Icon.astro';
import { investmentAssets } from '../data/assets';
import { getEntityDetails, getDetailPath } from '../data/entityDetails';

const {
  title = 'Listwin Ventures',
  description = 'Technology investing, leadership, and philanthropy from Don Listwin.',
  // Optional metadata overrides. Defaults keep every existing page working unchanged.
  canonical,
  ogType = 'website',
  ogImage,
  ogImageAlt = 'Listwin Ventures — Don Listwin',
  robots,
  jsonLd,
} = Astro.props;


const siteUrl = 'https://www.listwinventures.com';
const pagePath = `${Astro.url?.pathname ?? '/'}${Astro.url?.search ?? ''}${Astro.url?.hash ?? ''}`;
const pageUrl = new URL(pagePath, siteUrl).toString();
// Canonical ignores query/hash by design, and a page may point at a different URL entirely when
// two routes cover the same subject (e.g. /genologics vs /company/genologics).
// The trailing slash must be stripped: both /press and /press/ return 200, and an override
// pointing at "/genologics" would otherwise disagree with that page's own "/genologics/".
const stripTrailingSlash = (path: string) => {
  const trimmed = path.replace(/\/+$/, '');
  return trimmed === '' ? '/' : trimmed;
};
const canonicalUrl = new URL(
  stripTrailingSlash(canonical ?? Astro.url?.pathname ?? '/'),
  siteUrl,
).toString();
const logoPath = '/assets/media/listwin-ventures-logo.webp';
const logoUrl = `${siteUrl}${logoPath}`;
const openGraphImage = `${siteUrl}/assets/uploads/OpenGraph.png`;
// Per-page image when supplied, else the site card. Relative paths are resolved against the
// production origin because OG consumers require absolute URLs.
const socialImage = ogImage ? new URL(ogImage, siteUrl).toString() : openGraphImage;

// The site's own identity, deliberately NOT the per-page description — otherwise the Organization
// and WebSite entities claim a different description on every one of the 53 pages.
const siteDescription = 'Technology investing, leadership, and philanthropy from Don Listwin.';

// Every URL below was fetched and identity-confirmed against the page's own title. LinkedIn (999)
// and Crunchbase (403) bot-block automated checks, so they are deliberately omitted until someone
// confirms them in a browser — an unverified sameAs actively harms entity resolution.
const personSameAs = [
  'https://profiles.stanford.edu/don-listwin',
  'https://med.stanford.edu/profiles/don-listwin',
  'https://www.computerhistory.org/collections/catalog/102738863',
  'https://www.computerhistory.org/collections/catalog/102738862',
  'https://edrn.cancer.gov/about-edrn/sites/420-canary-foundation/listwin-don/',
  'https://canaryfoundation.org/about/founders-story',
  'https://x.com/Canarydon',
];

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${siteUrl}#organization`,
      name: 'Listwin Ventures',
      url: siteUrl,
      logo: {
        '@type': 'ImageObject',
        url: logoUrl,
      },
      description: siteDescription,
      founder: {
        '@id': `${siteUrl}#person`,
      },
    },
    {
      '@type': 'Person',
      '@id': `${siteUrl}#person`,
      name: 'Don Listwin',
      url: siteUrl,
      jobTitle: 'Founder and technology investor',
      description: 'Technology investor, CEO, philanthropist, and longtime operator.',
      worksFor: {
        '@id': `${siteUrl}#organization`,
      },
      sameAs: personSameAs,
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}#website`,
      url: siteUrl,
      name: 'Listwin Ventures',
      description: siteDescription,
      publisher: {
        '@id': `${siteUrl}#organization`,
      },
    },
    // Pages may append their own node (Organization, NewsArticle, PodcastSeries…). Appending to
    // the same @graph keeps it cross-linked to the Organization/Person/WebSite nodes above rather
    // than emitting a second, disconnected script.
    ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : []),
  ],
};

const entityDetails = getEntityDetails();
const detailBySlug = new Map(entityDetails.map((detail) => [detail.slug, detail]));

const hiddenInvestmentNavSlugs = new Set(['carbon-robotics', 'cradle']);

const prettify = (name: string) => name.replace(/\s+(logo|crest|lockup)$/i, '');

// Icon values are Lucide names rendered at build time by Icon.astro.
const workHighlights = [
  {
    label: 'Carbon Robotics',
    description: 'AI-driven laser weeding and farm autonomy.',
    href: getDetailPath('carbon-robotics') ?? '/',
    icon: 'tractor',
  },
  {
    label: '4AG Robotics',
    description: 'Autonomous mushroom cultivation and harvesting.',
    href: '/4ag',
    icon: 'bot',
  },
  {
    label: 'BelizeKids.org',
    description: 'STEM, clinics, and conservation across Belize.',
    href: '/belizekids',
    icon: 'heart-handshake',
  },
];

const investmentSections = investmentAssets
  .map((group) => {
    const items = group.items
      .map((asset) => detailBySlug.get(asset.id))
      .filter((detail) => detail && !hiddenInvestmentNavSlugs.has(detail.slug))
      .map((detail) => ({
        label: prettify(detail!.name),
        href: getDetailPath(detail!.slug)!,
      }));

    return { label: group.label, items };
  })
  .filter((section) => section.items.length > 0);

const communityLinks = [
  { slug: 'belizekids', icon: 'heart' },
  { slug: 'canary-foundation', icon: 'microscope' },
  { slug: 'lucile', icon: 'hospital' },
  { slug: 'nih', icon: 'landmark' },
  { slug: 'stanford', icon: 'graduation-cap' },
  { slug: 'saskatchewan', icon: 'library' },
]
  .map(({ slug, icon }) => {
    const detail = detailBySlug.get(slug);
    return detail
      ? {
          label: prettify(detail.name),
          href: getDetailPath(detail.slug)!,
          icon,
        }
      : null;
  })
  .filter((item): item is { label: string; href: string; icon: string } => Boolean(item));

const storyLinks = [
  { label: 'My Story', href: '/#my-story', icon: 'user-round', description: 'Forty years across networks, data, and health.' },
  { label: 'Caltech Interview ’25', href: '/oral-history-caltech', icon: 'audio-lines', description: 'Four-part oral history, audio + transcript.' },
  { label: 'Oral History ’18', href: '/oral-history', icon: 'video', description: 'Computer History Museum interview.' },
  { label: 'Press & References', href: '/press', icon: 'newspaper', description: 'Coverage, interviews, and sources.' },
];

const navItems = [
  { label: 'Home', href: '/', icon: 'house', mobileOnly: true },
  {
    label: 'Focus',
    sections: [{ label: 'Current focus', items: workHighlights }],
  },
  {
    label: 'Investments',
    sections: investmentSections,
  },
  {
    label: 'Community',
    sections: [{ label: 'Projects & partnerships', items: communityLinks }],
  },
  {
    label: 'About',
    sections: [{ label: 'Story', items: storyLinks }],
  },
  { label: 'Press', href: '/press' },
];

const footerColumns = [
  {
    label: 'Focus',
    links: [
      { label: 'Carbon Robotics', href: getDetailPath('carbon-robotics') ?? '/' },
      { label: '4AG Robotics', href: '/4ag' },
      { label: 'Investments', href: '/#investments' },
      { label: 'Exploits', href: '/#exploits' },
    ],
  },
  {
    label: 'Community',
    links: [
      { label: 'Canary Foundation', href: getDetailPath('canary-foundation') ?? '/' },
      { label: 'BelizeKids.org', href: '/belizekids' },
      { label: 'Stanford Medicine', href: getDetailPath('stanford') ?? '/' },
      { label: 'Canary Cove', href: '/exploits/canary-cove' },
    ],
  },
  {
    label: 'About',
    links: [
      { label: 'My Story', href: '/#my-story' },
      { label: 'Caltech Interview', href: '/oral-history-caltech' },
      { label: 'Oral History', href: '/oral-history' },
      { label: 'Press & References', href: '/press' },
    ],
  },
];

const rawPathname = Astro.url?.pathname ?? '/';
const pathname = rawPathname === '/' ? '/' : rawPathname.replace(/\/+$/, '');
const shareEnabledPaths = new Set([
  '/',
  '/oral-history',
  '/oral-history-caltech',
  '/press',
  '/4ag',
  '/belizekids',
  '/genologics',
  '/zevx-closes-20m-funding-round-appoints-don-listwin-as-ceo',
]);
const shareEnabledPrefixes = ['/company/', '/exploits/'];
const showSharePanel =
  shareEnabledPaths.has(pathname) || shareEnabledPrefixes.some((prefix) => pathname.startsWith(prefix));
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <!-- Theme before first paint: saved choice wins, otherwise follow the OS. No flash. -->
    <script is:inline>
      (() => {
        let stored = null;
        try {
          stored = window.localStorage.getItem('lv-theme');
        } catch (e) {}
        const dark = stored ? stored === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.classList.toggle('dark', dark);
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {robots && <meta name="robots" content={robots} />}
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#fbfbf9" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0c0e0d" />
    <meta property="og:site_name" content="Listwin Ventures" />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <link rel="icon" type="image/png" sizes="16x16" href="/assets/uploads/Favicon%201.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/uploads/Favicon%202.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/assets/uploads/Favicon%203.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/assets/uploads/Favicon%204.png" />
    <link rel="apple-touch-icon" href="/assets/uploads/Favicon%204.png" />
    <link rel="preconnect" href="https://res.cloudinary.com" crossorigin />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <div class="scroll-progress" aria-hidden="true"></div>
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[80] focus:rounded-full focus:bg-foreground focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-background"
    >
      Skip to content
    </a>

    <div class="flex min-h-screen flex-col">
      <header class="site-header sticky top-0 z-40" data-site-header>
        <div class="header-bar">
          <div class="container-lv flex h-16 items-center justify-between gap-4 lg:h-[4.5rem]">
            <a href="/" class="shrink-0 text-foreground" aria-label="Listwin Ventures home">
              <BrandMark />
            </a>
            <div class="flex items-center gap-2">
              <SiteNavigation items={navItems} contactHref="/contact" currentPath={pathname} />
              <button
                type="button"
                class="theme-toggle grid size-10 shrink-0 place-items-center rounded-full border border-border bg-card text-foreground transition-colors hover:bg-muted"
                data-theme-toggle
                aria-label="Switch to dark theme"
                title="Toggle theme"
              >
                <Icon name="sun" size={17} class="theme-icon-sun" />
                <Icon name="moon" size={17} class="theme-icon-moon" />
              </button>
            </div>
          </div>
        </div>
      </header>

      <main id="main-content" class="flex-1" tabindex="-1">
        <slot />
        {showSharePanel && <SharePanel pageUrl={pageUrl} pageTitle={title} />}
      </main>

      <footer class="site-footer relative overflow-hidden border-t border-border bg-card/40">
        <div class="container-lv pb-10 pt-20 sm:pt-24">
          <div class="grid gap-14 lg:grid-cols-[1.2fr_2fr]">
            <div class="space-y-6">
              <a href="/" class="inline-flex text-foreground" aria-label="Listwin Ventures home">
                <BrandMark />
              </a>
              <p class="max-w-sm text-[0.95rem] leading-relaxed text-muted-foreground">
                Technology investing, leadership, and philanthropy from Don Listwin — from networking and data to early
                cancer detection and AI robotics.
              </p>
              <a href="/contact" class="btn btn-secondary btn-sm">
                Get in touch
                <Icon name="arrow-right" size={15} class="arrow" />
              </a>
            </div>
            <div class="grid grid-cols-2 gap-10 sm:grid-cols-3">
              {footerColumns.map((column) => (
                <div>
                  <p class="font-mono text-[0.68rem] uppercase tracking-[0.16em] text-muted-foreground">{column.label}</p>
                  <ul class="mt-4 space-y-2.5">
                    {column.links.map((link) => (
                      <li>
                        <a href={link.href} class="text-[0.95rem] text-foreground/80 transition-colors hover:text-primary">
                          {link.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </div>

          <p class="footer-word mt-20 select-none font-display leading-[0.8] tracking-[-0.04em] text-foreground/[0.06]" aria-hidden="true">
            Listwin Ventures
          </p>

          <div class="mt-6 flex flex-col gap-4 border-t border-border pt-6 text-sm text-muted-foreground sm:flex-row sm:items-center sm:justify-between">
            <span>&copy; {new Date().getFullYear()} Listwin Ventures. All rights reserved.</span>
            <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
              <a href="/privacy-policy" class="transition-colors hover:text-foreground">Privacy</a>
              <a href="/cookie-policy" class="transition-colors hover:text-foreground">Cookies</a>
              <button type="button" data-cookie-preferences class="cursor-pointer transition-colors hover:text-foreground">
                Cookie preferences
              </button>
              <a href="https://x.com/Canarydon" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 transition-colors hover:text-foreground">
                <Icon name="tabler:brand-x" size={15} />
                <span>@Canarydon</span>
              </a>
            </div>
          </div>
        </div>
      </footer>
    </div>

    <!-- Cookie consent. Analytics load only after an explicit opt-in, and even then off the
         critical path (requestIdleCallback). Hidden until the loader confirms no prior decision. -->
    <div
      id="consent-banner"
      hidden
      role="region"
      aria-label="Cookie consent"
      aria-live="polite"
      class="fixed inset-x-0 bottom-0 z-50 p-3 sm:p-5"
    >
      <div class="consent-card mx-auto flex max-w-3xl flex-col gap-4 rounded-3xl border border-border bg-card/95 p-4 pl-5 shadow-[var(--shadow-panel)] backdrop-blur-xl sm:flex-row sm:items-center sm:justify-between">
        <p class="flex items-start gap-3 text-sm leading-relaxed text-muted-foreground">
          <Icon name="cookie" size={18} class="mt-0.5 shrink-0 text-foreground" />
          <span>
            We use analytics cookies to understand how visitors use this site. See our
            <a href="/cookie-policy" class="inline-link">Cookie Policy</a>.
          </span>
        </p>
        <div class="flex shrink-0 gap-2">
          <button type="button" data-consent-decline class="btn btn-secondary btn-sm flex-1 sm:flex-none">Decline</button>
          <button type="button" data-consent-accept class="btn btn-primary btn-sm flex-1 sm:flex-none">Accept</button>
        </div>
      </div>
    </div>

    <script is:inline>
      {(() => {
        const CONSENT_KEY = 'lv-analytics-consent';
        const GA_ID = 'G-5R6NTCMFK3';
        const HOTJAR_ID = 6585931;
        const HOTJAR_SV = 6;

        let loaded = false;
        const loadAnalytics = () => {
          if (loaded) return;
          loaded = true;
          const start = () => {
            const ga = document.createElement('script');
            ga.async = true;
            ga.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
            document.head.appendChild(ga);
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              window.dataLayer.push(arguments);
            }
            window.gtag = gtag;
            gtag('js', new Date());
            gtag('config', GA_ID);

            (function (h, o, t, j, a, r) {
              h.hj =
                h.hj ||
                function () {
                  (h.hj.q = h.hj.q || []).push(arguments);
                };
              h._hjSettings = { hjid: HOTJAR_ID, hjsv: HOTJAR_SV };
              a = o.getElementsByTagName('head')[0];
              r = o.createElement('script');
              r.async = 1;
              r.src = t + h._hjSettings.hjid + j + h._hjSettings.hjsv;
              a.appendChild(r);
            })(window, document, 'https://static.hotjar.com/c/hotjar-', '.js?sv=');
          };
          if ('requestIdleCallback' in window) {
            window.requestIdleCallback(start, { timeout: 3000 });
          } else {
            window.setTimeout(start, 1200);
          }
        };

        let decision = null;
        try {
          decision = window.localStorage.getItem(CONSENT_KEY);
        } catch (e) {}

        const banner = document.getElementById('consent-banner');
        if (!banner) return;
        if (decision === 'granted') loadAnalytics();
        if (decision !== 'granted' && decision !== 'denied') banner.hidden = false;

        const store = (value) => {
          try {
            window.localStorage.setItem(CONSENT_KEY, value);
          } catch (e) {}
        };
        const accept = banner.querySelector('[data-consent-accept]');
        const decline = banner.querySelector('[data-consent-decline]');
        document.querySelectorAll('[data-cookie-preferences]').forEach((control) => {
          control.addEventListener('click', () => {
            banner.hidden = false;
            accept?.focus();
          });
        });
        if (accept) {
          accept.addEventListener('click', () => {
            store('granted');
            banner.hidden = true;
            loadAnalytics();
          });
        }
        if (decline) {
          decline.addEventListener('click', () => {
            store('denied');
            banner.hidden = true;
            if (loaded) window.location.reload();
          });
        }
      })()}
    </script>

    <!-- Motion + theme. Progressive enhancement only: every page is complete without it. -->
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

        // Theme toggle (with a circular reveal where View Transitions are supported).
        const toggles = document.querySelectorAll('[data-theme-toggle]');
        const syncToggle = () => {
          const dark = root.classList.contains('dark');
          toggles.forEach((button) => {
            button.setAttribute('aria-label', dark ? 'Switch to light theme' : 'Switch to dark theme');
          });
        };
        syncToggle();
        toggles.forEach((button) => {
          button.addEventListener('click', (event) => {
            const next = !root.classList.contains('dark');
            const apply = () => {
              root.classList.toggle('dark', next);
              try {
                window.localStorage.setItem('lv-theme', next ? 'dark' : 'light');
              } catch (e) {}
              syncToggle();
            };
            if (!document.startViewTransition || reduceMotion.matches) {
              apply();
              return;
            }
            const rect = button.getBoundingClientRect();
            const x = event.clientX || rect.left + rect.width / 2;
            const y = event.clientY || rect.top + rect.height / 2;
            const radius = Math.hypot(Math.max(x, window.innerWidth - x), Math.max(y, window.innerHeight - y));
            root.classList.add('theme-transition');
            const transition = document.startViewTransition(apply);
            transition.ready
              .then(() => {
                root.animate(
                  { clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${radius}px at ${x}px ${y}px)`] },
                  { duration: 650, easing: 'cubic-bezier(0.16, 1, 0.3, 1)', pseudoElement: '::view-transition-new(root)' },
                );
              })
              .catch(() => {});
            transition.finished.finally(() => root.classList.remove('theme-transition'));
          });
        });
        // Follow OS changes until the visitor makes an explicit choice.
        window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (event) => {
          let stored = null;
          try {
            stored = window.localStorage.getItem('lv-theme');
          } catch (e) {}
          if (stored) return;
          root.classList.toggle('dark', event.matches);
          syncToggle();
        });

        // Header: transparent at the top, frosted once the page scrolls.
        const header = document.querySelector('[data-site-header]');
        if (header) {
          const onScroll = () => header.toggleAttribute('data-scrolled', window.scrollY > 8);
          onScroll();
          window.addEventListener('scroll', onScroll, { passive: true });
        }

        if (reduceMotion.matches || !('IntersectionObserver' in window)) return;
        root.classList.add('motion-ready');

        // Scroll reveals. Children of [data-reveal-stagger] get incremental delays.
        document.querySelectorAll('[data-reveal-stagger]').forEach((group) => {
          const step = Number(group.getAttribute('data-reveal-stagger')) || 70;
          Array.from(group.querySelectorAll(':scope > [data-reveal]')).forEach((child, index) => {
            child.style.setProperty('--reveal-delay', `${index * step}ms`);
          });
        });
        const revealObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-visible');
              revealObserver.unobserve(entry.target);
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );
        document.querySelectorAll('[data-reveal]').forEach((element) => revealObserver.observe(element));

        // Count-up numbers: <span data-count-to="40" data-count-suffix="+">40+</span>
        const counters = document.querySelectorAll('[data-count-to]');
        const countObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              countObserver.unobserve(entry.target);
              const element = entry.target;
              const target = Number(element.getAttribute('data-count-to'));
              const prefix = element.getAttribute('data-count-prefix') || '';
              const suffix = element.getAttribute('data-count-suffix') || '';
              const duration = 1600;
              const start = performance.now();
              const tick = (now) => {
                const progress = Math.min(1, (now - start) / duration);
                const eased = 1 - Math.pow(1 - progress, 4);
                element.textContent = `${prefix}${Math.round(target * eased)}${suffix}`;
                if (progress < 1) window.requestAnimationFrame(tick);
              };
              window.requestAnimationFrame(tick);
            });
          },
          { threshold: 0.6 },
        );
        counters.forEach((element) => countObserver.observe(element));

        // Pointer-tracked spotlight on cards (fine pointers only).
        if (window.matchMedia('(pointer: fine)').matches) {
          document.addEventListener(
            'pointermove',
            (event) => {
              const card = event.target instanceof Element ? event.target.closest('.spotlight') : null;
              if (!card) return;
              const rect = card.getBoundingClientRect();
              card.style.setProperty('--mx', `${event.clientX - rect.left}px`);
              card.style.setProperty('--my', `${event.clientY - rect.top}px`);
            },
            { passive: true },
          );
        }
      })();
    </script>
  </body>
</html>

<style>
  .header-bar {
    border-bottom: 1px solid transparent;
    transition:

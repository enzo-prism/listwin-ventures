---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import RelatedPressSection from '../components/RelatedPressSection.astro';
import Icon from '../components/Icon.astro';
import { belizeKidsGallery } from '../data/assets';
import { getExploitDetails } from '../data/exploitDetails';
import { getRelatedPressItems } from '../data/press';

// Visible copy, kept separate from the metadata below — see the note in 4ag.astro.
const heading = 'BelizeKids.org';
const intro =
  'Education, medical outreach, and marine conservation programs in Belize.';
const pageTitle = 'BelizeKids.org: Schools and Clinics | Listwin Ventures';
const pageDescription =
  'Don Listwin and his wife created BelizeKids.org to fund education, medical outreach, and conservation in Belize. See the programs and photos from the ground.';
const galleryImages = belizeKidsGallery;
const relatedPress = getRelatedPressItems('belizekids');

// Exploits whose own copy names BelizeKids.org (Hol Chan, Boca Del Rio, Canary Cove, the railroad).
const relatedProjects = getExploitDetails().filter((item) =>
  [item.summary, ...item.description, ...item.highlights].some((text) => text.includes('BelizeKids.org')),
);
const projectLabels: Record<string, string> = {
  events: 'Community Event',
  idea: 'Initiative',
  love: 'Community Project',
  fun: 'Personal Project',
};

// Asymmetric editorial grid: one feature frame, two companions, then a row of three.
const tileClasses = [
  'col-span-2 aspect-[4/3] lg:col-span-7 lg:row-span-2 lg:aspect-auto',
  'aspect-square lg:col-span-5 lg:aspect-auto',
  'aspect-square lg:col-span-5 lg:aspect-auto',
  'aspect-square lg:col-span-4 lg:aspect-auto',
  'aspect-square lg:col-span-4 lg:aspect-auto',
  'col-span-2 aspect-[16/9] lg:col-span-4 lg:aspect-auto',
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <PageHero
    eyebrow="Philanthropy"
    title={heading}
    intro={intro}
    crumbs={[
      { label: 'Home', href: '/' },
      { label: 'Community', href: '/#investments' },
      { label: heading },
    ]}
  >
    <a class="btn btn-primary" href="https://belizekids.org" target="_blank" rel="noopener noreferrer">
      Visit belizekids.org
      <Icon name="arrow-up-right" size={16} class="arrow-diag" />
    </a>
  </PageHero>

  <section class="container-lv pb-6" aria-label="Photos from BelizeKids.org programs">
    <div class="bk-gallery grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-12" data-reveal-stagger="70">
      {galleryImages.map((asset, index) => (
        <figure
          class:list={['bk-tile media-frame zoom-media group relative m-0 rounded-[1.5rem] sm:rounded-[1.75rem]', tileClasses[index] ?? 'aspect-square lg:col-span-4 lg:aspect-auto']}
          data-reveal
        >
          <img
            src={asset.path}
            alt={asset.alt}
            width="1200"
            height="900"
            loading={index < 3 ? 'eager' : 'lazy'}
            decoding="async"
          />
          <figcaption class="bk-caption chip absolute hidden sm:inline-flex bottom-3 left-3 right-3 z-[2] w-fit max-w-[calc(100%-1.5rem)] normal-case tracking-normal sm:bottom-4 sm:left-4">
            <span class="truncate">{asset.alt}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </section>

  {relatedProjects.length > 0 && (
    <section class="container-lv section-lv">
      <SectionHeading eyebrow="Connected work" title="Related <em>projects</em>">
        <a class="link-arrow text-sm" href="/#exploits">
          All exploits
          <Icon name="arrow-right" size={15} />
        </a>
      </SectionHeading>
      <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4" data-reveal-stagger="90">
        {relatedProjects.map((project) => (
          <article class="group card-lv card-hover spotlight relative flex h-full flex-col overflow-hidden p-2" data-reveal>
            <div class="media-frame zoom-media aspect-[4/3] rounded-[1.25rem]">
              <img src={project.heroImage} alt={project.heroAlt} width="768" height="576" loading="lazy" decoding="async" />
            </div>
            <div class="flex flex-1 flex-col px-4 pb-5 pt-5 sm:px-5">
              <p class="font-mono text-[0.68rem] uppercase tracking-[0.14em] text-muted-foreground">
                {projectLabels[project.category] ?? 'Project'}
              </p>
              <h3 class="mt-2 text-xl font-medium leading-snug tracking-[-0.01em]">
                <a href={`/exploits/${project.slug}`} class="stretched-link transition-colors group-hover:text-primary">
                  {project.title}
                </a>
              </h3>
              <p class="mt-3 flex-1 text-[0.95rem] leading-relaxed text-muted-foreground">{project.summary}</p>
              <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-medium text-foreground/80 transition-colors group-hover:text-primary" aria-hidden="true">
                Read more
                <Icon name="arrow-right" size={15} class="transition-transform duration-500 group-hover:translate-x-0.5" />
              </span>
            </div>
          </article>
        ))}
      </div>
    </section>
  )}

  <RelatedPressSection items={relatedPress} />
</BaseLayout>

<style>
  @media (min-width: 1024px) {
    .bk-gallery {
      grid-auto-rows: clamp(12rem, 19vw, 17rem);
    }
  }
  .bk-caption {
    font-family: var(--font-sans);
    font-size: 0.78rem;
    color: var(--foreground);
    background: color-mix(in oklab, var(--card) 88%, transparent);
    backdrop-filter: blur(8px);
  }
  @media (hover: hover) and (pointer: fine) {
    .bk-caption {
      opacity: 0;
      transform: translateY(6px);
      transition:
        opacity 400ms var(--ease-out-expo),
        transform 600ms var(--ease-out-expo);
    }
    .bk-tile:hover .bk-caption {
      opacity: 1;
      transform: none;
    }
  }
</style>

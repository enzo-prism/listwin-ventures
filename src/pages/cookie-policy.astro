---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = 'Cookie Policy | Listwin Ventures';
const pageDescription =
  'How Listwin Ventures uses essential storage and optional analytics, and how to change your choice.';
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <section class="rounded-apple bg-white/95 p-6 shadow-panel ring-1 ring-white/60 sm:p-10">
    <article class="mx-auto max-w-3xl space-y-7 text-base leading-7 text-ink/80 [overflow-wrap:anywhere]">
      <header class="space-y-2">
        <h1 class="text-3xl font-semibold text-ink">Cookie Policy</h1>
        <p>Last updated July 29, 2026.</p>
        <p>
          This policy explains the small amount of browser storage and optional analytics used on
          listwinventures.com.
        </p>
      </header>

      <section class="space-y-3">
        <h2 class="text-2xl font-semibold text-ink">Essential storage</h2>
        <p>
          The site stores your analytics choice in your browser under <code>lv-analytics-consent</code>. This prevents the
          consent notice from appearing on every visit. It does not identify you and is not used for advertising.
        </p>
      </section>

      <section class="space-y-3">
        <h2 class="text-2xl font-semibold text-ink">Optional analytics</h2>
        <p>
          Google Analytics and Hotjar load only after you select Accept. They help us understand page usage and improve the
          site. Selecting Decline prevents both services from loading.
        </p>
        <ul class="list-disc space-y-1 pl-6">
          <li>Google Analytics measures visits and site interactions.</li>
          <li>Hotjar provides aggregated interaction and usability insights.</li>
        </ul>
        <p>We do not use advertising or marketing cookies on this site.</p>
      </section>

      <section class="space-y-3">
        <h2 class="text-2xl font-semibold text-ink">Change your choice</h2>
        <p>
          Use the Cookie preferences button in the footer at any time. If analytics already loaded and you select Decline,
          the page refreshes so those services stop loading.
        </p>
        <button type="button" data-cookie-preferences class="btn btn-brand">Cookie preferences</button>
      </section>

      <section class="space-y-3">
        <h2 class="text-2xl font-semibold text-ink">Questions</h2>
        <p>
          Contact <a class="text-brand underline" href="mailto:privacy@listwinventures.com">privacy@listwinventures.com</a>.
        </p>
      </section>
    </article>
  </section>
</BaseLayout>

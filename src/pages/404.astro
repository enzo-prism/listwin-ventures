---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found | Listwin Ventures"
  description="The requested page could not be found."
  robots="noindex, nofollow"
>
  <section class="rounded-apple bg-white/95 p-8 text-center shadow-panel ring-1 ring-white/60 sm:p-14">
    <p class="text-sm font-semibold uppercase tracking-[0.35em] text-brand">404</p>
    <h1 class="mt-3 font-display text-4xl font-semibold text-ink sm:text-5xl">Page not found</h1>
    <p class="mx-auto mt-4 max-w-xl text-ink/70">
      This page may have moved or no longer exists.
    </p>
    <a class="btn btn-brand mt-7" href="/">Return home</a>
  </section>
</BaseLayout>

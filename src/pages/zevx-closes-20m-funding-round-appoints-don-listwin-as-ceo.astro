---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { heroAssets } from '../data/assets';

const pageTitle = 'ZEVX Raises $20M+, Names Don Listwin CEO | Listwin Ventures';
const pageDescription =
  'The February 2023 release: ZEVX closed over $20M led by Reynolds Capital and named Don Listwin CEO, with Kevin J. Kennedy joining as Chairman.';
const zevxLogo = heroAssets.find((asset) => asset.id === 'zevx');

// Visible headline (kept separate from the metadata strings above).
const heading = 'ZEVX Closes $20M+ Funding Round, Appoints Don Listwin as CEO';

// Dates and names below are taken verbatim from the release body rendered on this page.
const releaseSchema = {
  '@type': 'NewsArticle',
  headline: 'ZEVX Closes $20M Funding Round, Appoints Don Listwin as CEO',
  datePublished: '2023-02-16',
  about: 'ZEVX electric vehicle infrastructure funding and leadership announcement',
  author: { '@type': 'Organization', name: 'ZEVX' },
  publisher: { '@id': 'https://www.listwinventures.com#organization' },
  mainEntityOfPage: 'https://www.listwinventures.com/zevx-closes-20m-funding-round-appoints-don-listwin-as-ceo',
};
---

<BaseLayout title={pageTitle} description={pageDescription} ogType="article" jsonLd={releaseSchema}>
  <article class="zx-article">
    <!-- Masthead -->
    <header class="relative overflow-hidden border-b border-border">
      <div class="grid-lines opacity-50" aria-hidden="true"></div>
      <div class="container-lv relative z-10 pb-14 pt-14 sm:pb-20 sm:pt-20 lg:pt-24">
        <div class="mx-auto max-w-4xl">
          <nav aria-label="Breadcrumb" class="rise mb-10" style="--d:0ms">
            <ol class="flex flex-wrap items-center gap-1.5 text-sm text-muted-foreground">
              <li class="inline-flex items-center gap-1.5"><a href="/press" class="transition-colors hover:text-foreground">Press</a></li>
              <li class="inline-flex items-center gap-1.5">
                <Icon name="chevron-right" size={14} class="opacity-50" />
                <a href="/company/zevx" class="transition-colors hover:text-foreground">ZEVX</a>
              </li>
              <li class="inline-flex items-center gap-1.5">
                <Icon name="chevron-right" size={14} class="opacity-50" />
                <span aria-current="page" class="text-foreground/80">Press release</span>
              </li>
            </ol>
          </nav>

          <p class="rise flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-[0.72rem] uppercase tracking-[0.16em] text-muted-foreground" style="--d:60ms">
            <span class="text-primary">Press release</span>
            <span aria-hidden="true" class="opacity-40">/</span>
            <time datetime="2023-02-16">February 16, 2023</time>
            <span aria-hidden="true" class="opacity-40">/</span>
            <span>Gilbert, AZ</span>
          </p>
          <h1 class="zx-headline rise mt-6" style="--d:140ms">{heading}</h1>

          <div class="rise mt-10 flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between" style="--d:260ms">
            <div class="flex items-center gap-4">
              {zevxLogo && (
                <div class="logo-plate h-14 w-28 shrink-0 px-3 py-2.5 shadow-[var(--shadow-soft)] ring-1 ring-border">
                  <img src={zevxLogo.path} alt={zevxLogo.alt} width="300" height="141" loading="eager" decoding="async" class="h-full" />
                </div>
              )}
              <div class="text-sm leading-snug">
                <p class="font-medium text-foreground">ZEVX, Inc.</p>
                <p class="text-muted-foreground">For Immediate Release</p>
              </div>
            </div>
            <a href="/company/zevx" class="link-arrow text-sm">
              About Don’s ZEVX role
              <Icon name="arrow-right" size={15} />
            </a>
          </div>
        </div>
      </div>
    </header>

    <!-- Body -->
    <div class="container-lv section-tight">
      <div class="mx-auto grid max-w-5xl gap-12 lg:grid-cols-[13rem_minmax(0,1fr)] lg:gap-16">
        <!-- Side meta -->
        <aside class="zx-aside order-2 lg:order-1" aria-label="Release details">
          <div class="space-y-8">
            <div>
              <p class="font-mono text-[0.66rem] uppercase tracking-[0.16em] text-muted-foreground">For Immediate Release</p>
              <p class="mt-2 text-sm leading-relaxed text-foreground/80">
                <strong class="font-medium text-foreground">Contact:</strong><br />
                Peter Evers, ZEVX<br />
                <a class="inline-link" href="tel:+14153883680">(415) 388-3680</a><br />
                <a class="inline-link [overflow-wrap:anywhere]" href="mailto:pevers@zevx.com">pevers@zevx.com</a>
              </p>
            </div>
            <div>
              <p class="font-mono text-[0.66rem] uppercase tracking-[0.16em] text-muted-foreground">Led by</p>
              <p class="mt-2 text-sm text-foreground/80">Reynolds Capital</p>
            </div>
            <div>
              <p class="font-mono text-[0.66rem] uppercase tracking-[0.16em] text-muted-foreground">Leadership</p>
              <ul class="mt-2 space-y-1 text-sm text-foreground/80">
                <li>Don Listwin, CEO</li>
                <li>Kevin J. Kennedy, Chairman</li>
              </ul>
            </div>
          </div>
        </aside>

        <div class="order-1 min-w-0 lg:order-2">
          <aside class="zx-note flex gap-4 rounded-[var(--radius-xl)] border border-border bg-muted/60 p-5 text-sm leading-relaxed sm:p-6" data-reveal>
            <span class="inline-flex size-9 shrink-0 items-center justify-center rounded-full bg-card text-foreground ring-1 ring-border">
              <Icon name="archive" size={16} />
            </span>
            <p class="text-foreground/80">
              <strong class="font-medium text-foreground">Archive note:</strong> This page preserves a February 2023 announcement. ZEVX later
              liquidated its assets and wound down operations in 2024.
            </p>
          </aside>

          <div class="prose-lv zx-prose mt-10 [overflow-wrap:break-word]">
            <p class="zx-lead">
              <strong class="zx-dateline">GILBERT, AZ &mdash; February 16, 2023</strong> &mdash; ZEVX®, Inc., the worldwide
              leader in intelligent EV power system delivery, today announced closing over $20M in the first
              tranche of a funding round led by Reynolds Capital. In addition, the company announced the
              appointment of Don Listwin as CEO, Kevin J. Kennedy as Chairman and independent Board member,
              as well as David L. Shimek and Sidney Haider, of The Reynolds and Reynolds Company, as new
              Board members.
            </p>
            <p>
              With others participating, today&apos;s funding tranche was led by Reynolds Capital. Reynolds
              Capital is the investment arm of The Reynolds and Reynolds Company, the leading provider of
              automobile dealership software, services, and forms to help dealerships deliver better
              business results and transform the customer experience.
            </p>
            <p>
              ZEVX is a rapid innovator in battery electric power systems and data intelligence for
              e-mobility applications. The company has a series of premier battery electric powertrain and
              power system products that quickly migrate Class 2-6 commercial fleet assets and auxiliary
              power tools to zero carbon. ZEVX's platinum service mission starts with customers, operating
              through a deep partner network using existing automotive service infrastructure and tier 1
              fleet management companies (FMCs).
            </p>
            <p>
              Don Listwin joins ZEVX as CEO after serving as Executive Chairman. He spent a decade at Cisco
              Systems, where he served as executive vice president building several multi-billion-dollar
              lines of business, and previously held CEO roles with Sana Security, Openwave Systems, and
              RapidAI. Prior ZEVX CEO and Co-Founder Carolyn Maury has assumed the roles of CFO and CAO.
            </p>

            <blockquote class="zx-quote" data-reveal>
              <span class="zx-quote-mark" aria-hidden="true">“</span>
              <p>
                “As the world begins to embrace the massive overall move toward EV technology, ZEVX is leading
                the transformation of commercial fleets of all sizes toward electric and zero carbon,”
                <span class="zx-quote-said">said Don Listwin, CEO of ZEVX.</span> “To my mind there is no more
                impactful and promising business to be in right now. This new round of funding, with the addition
                of proven difference makers on the Board and the Executive Team, just adds to the momentum ZEVX has
                already achieved.”
              </p>
              <footer class="zx-quote-cite">Don Listwin · CEO, ZEVX</footer>
            </blockquote>

            <p>
              ZEVX welcomes three new members to its Board of Directors. Kevin J. Kennedy joins as Chairman
              and independent Board member. With an MS and a PhD in engineering, Kennedy has held prior roles
              as CEO of Avaya and JDS Uniphase Corporation, among others. David L. Shimek, Senior Vice
              President of Corporate Development at The Reynolds and Reynolds Company, and Sidney Haider,
              founder of AddOnAuto and Senior Vice President of Mergers and Acquisitions for The Reynolds and
              Reynolds Company, also join the board.
            </p>

            <blockquote class="zx-quote zx-quote-secondary" data-reveal>
              <span class="zx-quote-mark" aria-hidden="true">“</span>
              <p>
                “We always look to invest in difference makers focusing on technology innovations that fill
                proven market needs and have the potential to open new opportunities for the automotive retail
                industry,” <span class="zx-quote-said">said David L. Shimek, Senior Vice President of Corporate
                Development at The Reynolds and Reynolds Company.</span> “We’re encouraged by ZEVX’s bright future
                and capability to drive existing truck fleets toward a cleaner and more economical future. And
                we're excited to contribute to ZEVX’s growth and direction, as it fills a niche not being met in
                the marketplace today.”
              </p>
              <footer class="zx-quote-cite">David L. Shimek · The Reynolds and Reynolds Company</footer>
            </blockquote>

            <p>This historical release originally directed readers to the former ZEVX website.</p>

            <div class="zx-divider" aria-hidden="true"><span></span><span></span><span></span></div>

            <section aria-labelledby="zx-about-zevx">
              <h2 id="zx-about-zevx" class="display-sm text-foreground">About ZEVX at the time of this release</h2>
              <p>
                ZEVX® is the worldwide leader in delivering intelligent EV systems powering commercial class 2
                to 6 vehicles, power takeoff, reefer refrigeration, and EV infrastructure such as charging
                stations. ZEVX has a series of battery electric powertrain and power system products that
                quickly migrate commercial fleet assets to zero carbon. ZEVX supports customers through a deep
                partner network using existing automotive service infrastructure, providing rapid adoption via
                installation partners and advanced data intelligence to optimize the carbon transition.
              </p>
            </section>

            <section aria-labelledby="zx-about-reynolds">
              <h2 id="zx-about-reynolds" class="display-sm text-foreground">About Reynolds Capital</h2>
              <p>
                Reynolds Capital invests in early stage businesses positioned to shape the future of the
                automotive industry with innovative and groundbreaking technologies. Whether in data science,
                artificial intelligence, cybersecurity, or beyond, Reynolds Capital fosters opportunities that
                create new value in transportation. The firm, headquartered in Houston, Texas, is the
                investment arm of The Reynolds and Reynolds Company.
              </p>
            </section>
          </div>

          <!-- Source / next -->
          <footer class="mt-14 grid gap-4 sm:grid-cols-2" data-reveal-stagger="80">
            <a href="/company/zevx" class="group card-lv card-hover spotlight flex items-center gap-4 p-5" data-reveal>
              <span class="inline-flex size-11 shrink-0 items-center justify-center rounded-full bg-muted transition-colors group-hover:bg-accent group-hover:text-accent-foreground">
                <Icon name="building-2" size={18} />
              </span>
              <span class="min-w-0 flex-1">
                <span class="block font-mono text-[0.66rem] uppercase tracking-[0.16em] text-muted-foreground">Company</span>
                <span class="mt-0.5 block font-medium text-foreground">ZEVX</span>
              </span>
              <Icon name="arrow-right" size={16} class="text-muted-foreground transition-transform duration-500 group-hover:translate-x-1 group-hover:text-primary" />
            </a>
            <a href="/press" class="group card-lv card-hover spotlight flex items-center gap-4 p-5" data-reveal>
              <span class="inline-flex size-11 shrink-0 items-center justify-center rounded-full bg-muted transition-colors group-hover:bg-accent group-hover:text-accent-foreground">
                <Icon name="library" size={18} />
              </span>
              <span class="min-w-0 flex-1">
                <span class="block font-mono text-[0.66rem] uppercase tracking-[0.16em] text-muted-foreground">Library</span>
                <span class="mt-0.5 block font-medium text-foreground">Press &amp; References</span>
              </span>
              <Icon name="arrow-right" size={16} class="text-muted-foreground transition-transform duration-500 group-hover:translate-x-1 group-hover:text-primary" />
            </a>
          </footer>
        </div>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .zx-headline {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.35rem, 5.4vw, 4.4rem);
    line-height: 1.02;
    letter-spacing: -0.028em;
    max-width: 18ch;
  }

  .zx-prose {
    max-width: 40rem;
  }
  .zx-lead {
    font-size: 1.2rem;
    line-height: 1.7;
    color: var(--foreground);
  }
  .zx-dateline {
    font-family: var(--font-mono);
    font-size: 0.78em;
    font-weight: 500;
    letter-spacing: 0.06em;
  }
  .zx-prose h2 {
    margin-top: 2.5rem;
  }
  .zx-prose section > * + * {
    margin-top: 1rem;
  }

  @media (min-width: 1024px) {
    .zx-aside > div {
      position: sticky;
      top: 7.5rem;
    }
  }

  /* Pull quotes */
  .zx-quote {
    position: relative;
    margin-block: 4rem 3rem !important;
    padding: 2.25rem 0 0 0;
    border-top: 1px solid var(--border);
  }
  .zx-quote p {
    font-family: var(--font-display);
    font-size: clamp(1.45rem, 2.4vw, 1.85rem);
    line-height: 1.28;
    letter-spacing: -0.012em;
    color: var(--foreground);
  }
  .zx-quote-secondary p {
    font-size: clamp(1.25rem, 2vw, 1.5rem);
  }
  .zx-quote-said {
    font-family: var(--font-sans);
    font-size: 0.6em;
    letter-spacing: 0;
    color: var(--muted-foreground);
  }
  .zx-quote-mark {
    position: absolute;
    top: -0.3em;
    left: 0;
    padding-right: 0.2em;
    background: var(--background);
    font-family: var(--font-display);
    font-size: 4rem;
    line-height: 0.8;
    height: 0.6em;
    overflow: hidden;
    color: var(--primary);
  }
  .zx-quote-cite {
    margin-top: 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted-foreground);
  }
  .zx-quote-cite::before {
    content: '— ';
  }

  .zx-divider {
    display: flex;
    justify-content: center;
    gap: 0.6rem;
    padding-block: 1.5rem;
  }
  .zx-divider span {
    width: 0.3rem;
    height: 0.3rem;
    border-radius: 999px;
    background: var(--input);
  }
</style>

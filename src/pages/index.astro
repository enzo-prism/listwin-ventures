<script is:inline>
  // Timeline arrows: progressive enhancement over a native, swipeable scroll-snap track.
  (() => {
    const track = document.querySelector('[data-timeline-track]');
    const controls = document.querySelector('[data-timeline-controls]');
    if (!track || !controls) return;
    controls.hidden = false;
    const step = () => Math.max(track.clientWidth * 0.7, 280);
    const behavior = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';
    controls.querySelector('[data-timeline-prev]')?.addEventListener('click', () => track.scrollBy({ left: -step(), behavior }));
    controls.querySelector('[data-timeline-next]')?.addEventListener('click', () => track.scrollBy({ left: step(), behavior }));
  })();
</script>

<style>
  /* Rotating role line: three words cycle vertically; static first word without motion. */
  .role-rotator {

---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import LogoTile from '../components/LogoTile.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CtaBand from '../components/CtaBand.astro';
import NetworkHalo from '../components/NetworkHalo.astro';
import { boardAssets, heroAssets, investmentAssets, type VisualAsset } from '../data/assets';
import { getDetailPath, getEntityDetails, type EntityDetail } from '../data/entityDetails';
import { getExploitPath } from '../data/exploitDetails';
import { getPressItems, isExternalUrl, type PressItem } from '../data/press';
import { darkPlateLogoIds } from '../lib/logos';

const profileSchema = {
  '@type': 'ProfilePage',
  '@id': 'https://www.listwinventures.com/#webpage',
  url: 'https://www.listwinventures.com/',
  isPartOf: { '@id': 'https://www.listwinventures.com#website' },
  about: { '@id': 'https://www.listwinventures.com#person' },
  mainEntity: { '@id': 'https://www.listwinventures.com#person' },
};
const pageTitle = 'Don Listwin, Technology Investor | Listwin Ventures';
const pageDescription =
  'Don Listwin spent a decade at Cisco and led Openwave and RapidAI as CEO. See his investments across AI, robotics, and data, plus his cancer detection work.';

const carbonRoboticsDetailPath = getDetailPath('carbon-robotics');
const portrait = heroAssets.find((asset) => asset.id === 'don-listwin');
const entityDetails = getEntityDetails();
const entityDetailMap = new Map<string, EntityDetail>(entityDetails.map((detail) => [detail.slug, detail]));
const hiddenInvestmentSlugs = new Set(['cradle']);
const pressItems = getPressItems();
const verifiedLinkIds = [
  'stanford-medicine-deans-medal-2018-11-01',
  'stanford-medicine-profile-don-listwin',
  'stanford-canary-center-history',
];
const verifiedLinks = verifiedLinkIds
  .map((id) => pressItems.find((item) => item.id === id))
  .filter((item): item is PressItem => Boolean(item));
const portraitPressItem = pressItems.find((item) => item.photo?.kind === 'hosted');
const hostedPortrait =
  portraitPressItem && portraitPressItem.photo?.kind === 'hosted' ? portraitPressItem.photo : null;

// Stage groups for the investments ledger. "Frontier" and the archived group are not shown.
const stageNotes: Record<string, string> = {
  Seed: 'Earliest conviction',
  Private: 'Growth-stage companies',
  Venture: 'Funds & partnerships',
  Public: 'Listed companies',
  Philanthropic: 'Mission-driven',
  Exits: 'Acquired, merged, or closed',
};
const investmentGroups = investmentAssets
  .filter((group) => group.label !== 'Frontier' && group.label !== 'Archived')
  .map((group) => ({
    label: group.label,
    note: stageNotes[group.label] ?? '',
    items: group.items
      .map((asset) => ({ asset, detail: entityDetailMap.get(asset.id) }))
      .filter((entry): entry is { asset: VisualAsset; detail: EntityDetail } =>
        Boolean(entry.detail) && !hiddenInvestmentSlugs.has(entry.asset.id),
      ),
  }))
  .filter((group) => group.items.length > 0);

// Every distinct logo across boards and investments, for the marquee.
const marqueeLogos = (() => {
  const seen = new Set<string>();
  return [...boardAssets.flatMap((group) => group.items), ...investmentAssets.flatMap((group) => group.items)].filter(
    (asset) => {
      if (seen.has(asset.id) || asset.id === '4ag' || asset.id === 'cradle') return false;
      seen.add(asset.id);
      return true;
    },
  );
})();

const linkTargets = {
  openwave: getDetailPath('openwave'),
  rapidai: getDetailPath('rapidai'),
  fourAg: '/4ag',
  carbonRobotics: getDetailPath('carbon-robotics'),
  canary: getDetailPath('canary-foundation'),
  sequoia: getDetailPath('sequoia'),
  rally: getDetailPath('rally'),
  belizekids: getDetailPath('belizekids'),
  stanford: getDetailPath('stanford'),
  canaryChallenge: getDetailPath('canary-challenge'),
  zevx: getDetailPath('zevx'),
};

// Every figure below is stated in the "My Story" copy on this page.
const stats = [
  { value: 40, suffix: '+', label: 'Years in the technology industry' },
  { value: 10, suffix: '', label: 'Years building businesses at Cisco' },
  { value: 12, prefix: '$', suffix: 'B+', label: 'Annual revenue across the businesses he oversaw' },
  { value: 4, suffix: '', label: 'Current board seats' },
];

// Milestones, all drawn from the story copy and the press library.
const milestones = [
  {
    year: '1980',
    title: 'Develcon',
    body: 'Began his career in Canada, marketing data switching technology for the mini-computer era.',
    icon: 'radio',
  },
  {
    year: '1990',
    title: 'Cisco Systems',
    body: 'Joined as employee #410. Over a decade he built the IBM, Access, and Service Provider businesses — more than $12B in annual revenue.',
    icon: 'network',
  },
  {
    year: '2000',
    title: 'Openwave',
    body: 'CEO of the public company whose software helped make the early mobile internet work.',
    icon: 'smartphone',
    href: linkTargets.openwave,
  },
  {
    year: '2004',
    title: 'Canary Foundation',
    body: 'Founded to fund, discover, and develop tests for the early detection of cancer.',
    icon: 'microscope',
    href: linkTargets.canary,
  },
  {
    year: '2009',
    title: 'National Cancer Institute',
    body: 'Appointed to the NCI’s Board of Scientific Advisors.',
    icon: 'landmark',
  },
  {
    year: '2010',
    title: 'BelizeKids.org',
    body: 'Co-created with his wife to support community and education initiatives in Belize.',
    icon: 'heart-handshake',
    href: '/belizekids',
  },
  {
    year: '2018',
    title: 'Stanford Dean’s Medal',
    body: 'The School of Medicine’s highest honor; also began his tenure as CEO of RapidAI (2018–2021).',
    icon: 'award',
    href: linkTargets.stanford,
  },
  {
    year: '2023',
    title: 'ZEVX',
    body: 'Named CEO as ZEVX closed a funding round of more than $20M.',
    icon: 'zap',
    href: '/zevx-closes-20m-funding-round-appoints-don-listwin-as-ceo',
  },
  {
    year: '2025',
    title: 'Carbon Robotics',
    body: 'Joined the board as Lead Independent Director — AI, robotics, and agriculture.',
    icon: 'tractor',
    href: linkTargets.carbonRobotics,
  },
];

const carbonPressReleaseUrl =
  'https://www.businesswire.com/news/home/20250602427241/en/Carbon-Robotics-Adds-Lead-Independent-Director-to-Board';

const focusCards = [
  {
    kicker: 'Lead Independent Director',
    title: 'Carbon Robotics',
    description:
      'Carbon Robotics is revolutionizing agriculture with AI-guided laser weeding and tractor autonomy so growers can cut inputs, fight labor shortages, and capture agronomic data every pass.',
    image: '/assets/media/carbon-laserweeder.webp',
    imageAlt: 'Carbon Robotics LaserWeeder working a field at dusk',
    href: carbonRoboticsDetailPath ?? '/',
    linkLabel: 'Explore Carbon Robotics',
    secondary: { label: 'Press release', href: carbonPressReleaseUrl },
  },
  {
    kicker: 'Board member',
    title: '4AG Robotics',
    description: '4AG builds robots that pick, trim, and pack mushrooms at industrial scale.',
    image: '/assets/media/4ag-robot.webp',
    imageAlt: '4AG autonomous mushroom harvesting robot in a grow room',
    href: '/4ag',
    linkLabel: 'Explore 4AG',
    secondary: { label: '4AG.ai', href: 'https://4ag.ai' },
  },
];

const interviews = [
  {
    kicker: 'Caltech Heritage Project · 2025',
    title: 'Caltech Heritage Project Oral History',
    body: 'Four sessions with Don Listwin on leadership, investing, and building systems for early cancer detection.',
    href: '/oral-history-caltech',
    icon: 'audio-lines',
    meta: '4 episodes · Audio + transcript',
  },
  {
    kicker: 'Computer History Museum · 2018',
    title: 'Oral History of Don Listwin',
    body: 'The Computer History Museum oral history covering Cisco’s growth, Openwave, leadership lessons, and the Canary Foundation.',
    href: '/oral-history',
    icon: 'play',
    meta: 'Video + full transcript',
  },
];

const cardMedia: Record<
	  string,
	  {
	    path: string;
	    alt: string;
	  }
	> = {
  netaid: {
    path: '/assets/uploads/2020/09/netaid-768x598.jpg',
    alt: 'NetAid concert with performers raising funds for anti-poverty initiatives',
  },
  sjgp: {
    path: '/assets/uploads/2020/09/sjgp-768x576.jpg',
    alt: 'Champ cars racing through downtown San Jose streets during the Grand Prix',
  },
  'canary-foundation': {
    path: '/assets/uploads/2020/10/canary-foundation.jpg',
    alt: 'Canary Foundation researchers collaborating inside the lab',
  },
  'canary-center': {
    path: '/assets/uploads/2020/09/canary-center-768x457.jpg',
    alt: 'Exterior of the Canary Center at Stanford with modern glass architecture',
  },
  'canary-challenge': {
    path: '/assets/uploads/2020/09/canary-challenge-768x608.jpg',
    alt: 'Cyclists riding in the Canary Challenge charity event',
  },
  'cancer-conference': {
    path: '/assets/uploads/2020/09/cancer-conference-768x662.jpg',
    alt: 'Early Detection of Cancer Conference audience and speaker session',
  },
  'vision-clinic': {
    path: '/assets/uploads/2020/09/vision-clinic-768x685.jpg',
    alt: 'Doctors providing eye exams at the Belize vision clinic',
  },
  catholic: {
    path: '/assets/uploads/2020/09/catholic-768x653.jpg',
    alt: 'Students outside San Pedro Roman Catholic Primary School',
  },
  adventist: {
    path: '/assets/uploads/2020/09/adventist-768x526.jpg',
    alt: 'Students gathered near New Horizon SDA Primary School upgrades',
  },
  'hol-chan': {
    path: '/assets/uploads/2020/09/hol-chan-768x606.jpg',
    alt: 'Hol Chan Marine Reserve waters and tour boats near the reef',
  },
  boca: {
    path: '/assets/uploads/2020/09/boca-768x545.jpg',
    alt: 'Families enjoying the renovated Boca Del Rio Park playground',
  },
  'canary-cove': {
    path: '/assets/uploads/2020/12/caaray-cove-01-768x511.jpg',
    alt: 'Canary Cove beachfront villas and dock on Ambergris Caye',
  },
	  railroad: {
	    path: '/assets/uploads/2020/12/railroad-768x576.jpg',
	    alt: 'Chelsea & Woodside backyard railroad with Don Listwin driving the train',
	  },
	};

	const inferImageDimensionsFromPath = (path: string): { width: number; height: number } => {
	  const match = path.match(/-(\d+)x(\d+)\.(?:png|jpe?g|webp)(?:\?|$)/i);
	  if (match) {
	    return { width: Number(match[1]), height: Number(match[2]) };
	  }
	  // Reasonable default for WP-style photos when size isn't encoded in the filename.
	  return { width: 768, height: 576 };
	};

const exploitThemes = [
  {
    kicker: 'BIG EVENTS',
    heading: 'Creating Awareness and Driving Impact',
    description: null,
    cards: [
      {
        title: 'NetAid',
        description:
          'NETAID was an anti-poverty initiative co-founded by the United Nations Development Programme and Cisco Systems with a 1999 concert and simultaneous digital events spanning 40+ countries.',
        tag: 'netaid',
        link: getExploitPath('netaid'),
      },
      {
        title: 'San Jose Grand Prix',
        description:
          'SAN JOSE GRAND PRIX brought Champ Car racing to Silicon Valley, amplifying Canary Foundation’s mission and the importance of early cancer detection.',
        tag: 'sjgp',
        link: getExploitPath('san-jose-grand-prix'),
      },
    ],
  },
  {
    kicker: 'BIG IDEA',
    heading: 'Advancing Early Cancer Detection',
    description: null,
    cards: [
      {
        title: 'Canary Foundation',
        description:
          'Founded in 2004 to fund collaborative research and advance tests for early cancer detection.',
        tag: 'canary-foundation',
        link: linkTargets.canary,
      },
      {
        title: 'Canary Center at Stanford',
        description:
          'A world-class research facility focused on minimally invasive diagnostics and imaging strategies for detecting cancers at curable stages.',
        tag: 'canary-center',
        link: linkTargets.stanford,
      },
      {
        title: 'Canary Challenge',
        description:
          'An annual fully supported bike ride whose proceeds benefited the Stanford Cancer Institute and Canary Center to advance cancer research and supportive care.',
        tag: 'canary-challenge',
        link: linkTargets.canaryChallenge,
      },
      {
        title: 'Early Detection of Cancer Conference',
        description:
          'A cross-disciplinary conference series investing in early detection research, screening accuracy, and the biology of early-stage cancers.',
        tag: 'cancer-conference',
        link: getExploitPath('cancer-conference'),
      },
    ],
  },
  {
    kicker: 'BIG LOVE',
    heading: 'Helping Communities in Belize',
    description: null,
    cards: [
      {
        title: 'Belize Vision Clinic',
        description:
          'Partnering with BCVI and Stanford Medicine, this clinic provides comprehensive eye care for San Pedro residents through BelizeKids.org.',
        tag: 'vision-clinic',
        link: linkTargets.belizekids,
      },
      {
        title: 'San Pedro Roman Catholic Primary School',
        description:
          'Expanded with new classrooms, electrical upgrades, and refreshed facilities to support 700+ students.',
        tag: 'catholic',
        link: linkTargets.belizekids,
      },
      {
        title: 'New Horizon SDA Primary School',
        description:
          'Added classrooms, shaded palapa space, and infrastructure repairs to serve more than 500 students.',
        tag: 'adventist',
        link: linkTargets.belizekids,
      },
      {
        title: 'Hol Chan Marine Reserve + SP Tour Guide Association',
        description:
          'Created “no-take” zones, installed mooring buoys, and supported sustainable tourism to protect Belize’s reef.',
        tag: 'hol-chan',
        link: getExploitPath('hol-chan'),
      },
      {
        title: 'Boca Del Rio Park Playground',
        description:
          'Renovated beachfront park with palapas, playground equipment, and sports upgrades for families.',
        tag: 'boca',
        link: getExploitPath('boca-del-rio-park'),
      },
    ],
  },
  {
    kicker: 'BIG FUN',
    heading: 'Creating Delight',
    description: null,
    cards: [
      {
        title: 'Canary Cove',
        description:
          'A private resort on Ambergris Caye bringing family, friends, and business teams together in Belize.',
        tag: 'canary-cove',
        link: getExploitPath('canary-cove'),
      },
      {
        title: 'Chelsea & Woodside Railroad',
        description:
          'A backyard railroad experience complete with Don as train conductor to delight kids of all ages.',
        tag: 'railroad',
        link: getExploitPath('chelsea-woodside-railroad'),
      },
    ],
  },
];

---

<BaseLayout title={pageTitle} description={pageDescription} jsonLd={profileSchema}>
  <!-- ─────────────── Hero ─────────────── -->
  <section class="home-hero relative overflow-hidden">
    <div class="aurora" aria-hidden="true"></div>
    <div class="grid-lines" aria-hidden="true"></div>
    <div class="container-lv relative z-10 grid items-center gap-14 pb-20 pt-10 sm:pt-16 lg:min-h-[calc(100svh-4.5rem)] lg:grid-cols-[1.15fr_0.85fr] lg:gap-10 lg:pb-24 lg:pt-8">
      <div>
        <a href="#focus" class="chip chip-live rise transition-colors hover:border-primary/40 hover:text-foreground" style="--d:0ms">
          Now: AI robotics in agriculture
        </a>
        <p class="eyebrow rise mt-8" style="--d:80ms">
          <span class="sr-only">Roles: </span>
          <span class="role-rotator" aria-hidden="true">
            <span>Technology investor</span>
            <span>CEO</span>
            <span>Philanthropist</span>
          </span>
          <span class="sr-only">Technology investor, CEO, philanthropist</span>
        </p>
        <h1 class="display-xl rise-words mt-5">
          <span class="word" style="--i:0">Don</span>
          <span class="word" style="--i:1"><em>Listwin</em></span>
        </h1>
        <p class="lede rise mt-8 max-w-xl" style="--d:420ms">
          Building enduring companies across networking, data, and health while backing founders who pair engineering rigor
          with human impact — and now digging into AgTech, AI, and robotics.
        </p>
        <div class="rise mt-10 flex flex-wrap items-center gap-3" style="--d:540ms">
          <a href="#my-story" class="btn btn-primary">
            Read my story
            <Icon name="arrow-down" size={16} class="arrow" />
          </a>
          <a href="#investments" class="btn btn-secondary">
            Investments
          </a>
        </div>
        <dl class="rise mt-14 grid max-w-lg grid-cols-3 gap-6 border-t border-border pt-6" style="--d:660ms">
          <div>
            <dt class="font-mono text-[0.65rem] uppercase tracking-[0.14em] text-muted-foreground">Built</dt>
            <dd class="mt-1 text-sm font-medium">Cisco · Openwave</dd>
          </div>
          <div>
            <dt class="font-mono text-[0.65rem] uppercase tracking-[0.14em] text-muted-foreground">Founded</dt>
            <dd class="mt-1 text-sm font-medium">Canary Foundation</dd>
          </div>
          <div>
            <dt class="font-mono text-[0.65rem] uppercase tracking-[0.14em] text-muted-foreground">Backing</dt>
            <dd class="mt-1 text-sm font-medium">AI · Robotics · Data</dd>
          </div>
        </dl>
      </div>

      <div class="hero-visual rise relative mx-auto w-full max-w-[34rem]" style="--d:200ms">
        <div class="absolute inset-[-8%]" aria-hidden="true">
          <NetworkHalo />
        </div>
        {portrait && (
          <figure class="portrait-frame relative mx-auto aspect-[640/702] w-[72%] overflow-hidden rounded-[2.25rem] border border-border bg-muted shadow-[var(--shadow-panel)]">
            <img
              src={portrait.path}
              alt={portrait.alt}
              width="640"
              height="702"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="h-full w-full object-cover"
            />
          </figure>
        )}
        <div class="hero-badge float-a absolute -left-1 top-[14%] sm:left-0">
          <span class="grid size-9 place-items-center rounded-xl bg-accent text-accent-foreground"><Icon name="network" size={17} /></span>
          <span>
            <span class="block text-[0.8rem] font-medium leading-tight">Cisco Systems</span>
            <span class="block font-mono text-[0.62rem] uppercase tracking-[0.12em] text-muted-foreground">1990 – 2000</span>
          </span>
        </div>
        <div class="hero-badge float-b absolute -right-1 bottom-[16%] sm:right-0">
          <span class="grid size-9 place-items-center rounded-xl bg-accent text-accent-foreground"><Icon name="microscope" size={17} /></span>
          <span>
            <span class="block text-[0.8rem] font-medium leading-tight">Canary Foundation</span>
            <span class="block font-mono text-[0.62rem] uppercase tracking-[0.12em] text-muted-foreground">Founded 2004</span>
          </span>
        </div>
      </div>
    </div>
    <a href="#logos" class="scroll-cue absolute bottom-6 left-1/2 hidden -translate-x-1/2 lg:flex" aria-label="Scroll to content">
      <span class="scroll-cue-dot"></span>
    </a>
  </section>

  <!-- ─────────────── Logo marquee ─────────────── -->
  <section id="logos" class="border-y border-border bg-card/50 py-10" aria-label="Boards, investments, and exits">
    <p class="container-lv mb-7 text-center font-mono text-[0.68rem] uppercase tracking-[0.18em] text-muted-foreground">
      Boards, investments &amp; exits across four decades
    </p>
    <div class="marquee" style="--marquee-duration:70s">
      <div class="marquee-track gap-3 pr-3">
        {[0, 1].map((copy) => (
          <div class="flex shrink-0 gap-3" aria-hidden={copy === 1 ? 'true' : undefined}>
            {marqueeLogos.map((asset) => (
              <span class:list={['logo-plate h-16 w-40 shrink-0 border border-border px-6 sm:h-[4.5rem] sm:w-44', darkPlateLogoIds.has(asset.id) && 'is-dark']}>
                <img
                  src={asset.path}
                  alt={copy === 1 ? '' : asset.alt}
                  width="320"
                  height="128"
                  loading="lazy"
                  decoding="async"
                  class="max-h-8 w-auto max-w-full sm:max-h-9"
                />
              </span>
            ))}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ─────────────── Numbers ─────────────── -->
  <section class="container-lv section-tight" aria-label="By the numbers">
    <dl class="grid grid-cols-2 gap-x-6 gap-y-12 lg:grid-cols-4" data-reveal-stagger="90">
      {stats.map((stat) => (
        <div data-reveal class="border-l border-border pl-5 sm:pl-6">
          <dd
            class="stat-num"
            data-count-to={stat.value}
            data-count-prefix={stat.prefix ?? ''}
            data-count-suffix={stat.suffix}
          >
            {stat.prefix ?? ''}{stat.value}{stat.suffix}
          </dd>
          <dt class="mt-3 max-w-[14rem] text-sm leading-snug text-muted-foreground">{stat.label}</dt>
        </div>
      ))}
    </dl>
  </section>

  <!-- ─────────────── Current focus ─────────────── -->
  <section id="focus" class="container-lv section-lv pt-8">
    <SectionHeading eyebrow="Current focus" title="Where engineering meets the <em>field</em>">
      <p class="max-w-sm text-[0.95rem] leading-relaxed text-muted-foreground md:text-right">
        Board work at the frontier of AI-driven agriculture: autonomous machines that make farming cleaner and more productive.
      </p>
    </SectionHeading>
    <div class="mt-14 grid gap-5 lg:grid-cols-2" data-reveal-stagger="120">
      {focusCards.map((card) => (
        <article data-reveal class="focus-card group relative isolate flex min-h-[30rem] flex-col justify-end overflow-hidden rounded-[2rem] text-white sm:min-h-[36rem]">
          <img
            src={card.image}
            alt={card.imageAlt}
            width="1600"
            height="900"
            loading="lazy"
            decoding="async"
            class="absolute inset-0 -z-10 h-full w-full object-cover transition-transform duration-[1600ms] ease-[var(--ease-out-expo)] group-hover:scale-[1.05]"
          />
          <div class="focus-scrim absolute inset-0 -z-10" aria-hidden="true"></div>
          <div class="p-7 sm:p-10">
            <p class="font-mono text-[0.68rem] uppercase tracking-[0.18em] text-white/70">{card.kicker}</p>
            <h3 class="mt-3 font-display text-[2.6rem] leading-none tracking-[-0.02em] sm:text-[3.25rem]">
              <a href={card.href} class="stretched-link">{card.title}</a>
            </h3>
            <p class="mt-4 max-w-md text-[0.98rem] leading-relaxed text-white/80">{card.description}</p>
            <div class="relative z-[3] mt-7 flex flex-wrap items-center gap-3">
              <span class="btn btn-sm bg-white text-neutral-950 group-hover:bg-white/90" aria-hidden="true">
                {card.linkLabel}
                <Icon name="arrow-right" size={15} class="arrow" />
              </span>
              <a
                href={card.secondary.href}
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn-sm border-white/30 text-white backdrop-blur-sm hover:bg-white/10"
              >
                {card.secondary.label}
                <Icon name="arrow-up-right" size={14} class="arrow-diag" />
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- ─────────────── My Story ─────────────── -->
  <section id="my-story" class="story relative border-t border-border bg-card/40">
    <div class="container-lv section-lv grid gap-14 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
      <div class="lg:sticky lg:top-28 lg:self-start" data-reveal>
        <p class="eyebrow">My story</p>
        <h2 class="display-md mt-4">Forty years of building what <em>connects</em> us.</h2>
        <p class="mt-6 max-w-sm text-[0.95rem] leading-relaxed text-muted-foreground">
          From data switching in the mini-computer era to AI in the farm field — told in Don’s own words.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a class="btn btn-secondary btn-sm" href="/oral-history">
            <Icon name="play" size={14} />
            Watch the oral history
          </a>
        </div>
      </div>

      <div class="prose-lv max-w-[42rem]" data-reveal>
        <p class="story-lead !text-[1.2rem] !leading-[1.6] text-foreground sm:!text-[1.45rem]">

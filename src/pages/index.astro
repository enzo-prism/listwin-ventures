  .role-rotator > span:not(:first-child) {
    opacity: 0;
  }
  @media (prefers-reduced-motion: no-preference) {
    .role-rotator > span {
      opacity: 0;
      animation: role-cycle 7.5s var(--ease-out-expo) infinite;
    }
    .role-rotator > span:nth-child(2) {
      animation-delay: 2.5s;
    }
    .role-rotator > span:nth-child(3) {
      animation-delay: 5s;
    }
  }
  /* Each word owns a third of the cycle, so exactly one is always on screen. */
  @keyframes role-cycle {
    0% {
      opacity: 0;
      transform: translateY(100%);
    }
    4%,
    30% {
      opacity: 1;

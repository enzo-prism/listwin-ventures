---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import RelatedPressSection from '../components/RelatedPressSection.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { getDetailPath, getEntityDetails } from '../data/entityDetails';
import { getRelatedPressItems } from '../data/press';

// Visible copy, kept separate from the metadata below — see the note in 4ag.astro.
const heading = 'GenoLogics';
const intro =
  'Lab information management software for proteomics and sequencing labs, acquired by Illumina in 2015.';
const pageTitle = 'GenoLogics — LIMS Acquired by Illumina | Listwin Ventures';
const pageDescription =
  'GenoLogics built lab information management software for proteomics and sequencing labs, then sold to Illumina in 2015. Read the timeline behind the exit.';

const genologicsDetail = getEntityDetails().find((detail) => detail.slug === 'genologics');
const officialDetailHref = genologicsDetail ? getDetailPath('genologics') : null;
const relatedPress = getRelatedPressItems('genologics');

const timeline = [
  {
    label: '2003–2005',
    title: 'Origins in proteomics labs',
    description:
      'GenoLogics built configurable lab information management software (LIMS) so translational researchers could tie together instruments, SOPs, and growing volumes of proteomics data.',
  },
  {
    label: '2006–2010',
    title: 'NGS acceleration',
    description:
      'Next-generation sequencing took off and the platform evolved to coordinate sample prep, run planning, and QC reporting so research hospitals could scale their programs.',
  },
  {
    label: '2012–2015',
    title: 'Acquisition by Illumina',
    description:
      'Illumina acquired GenoLogics in 2015 to deliver tighter workflows between the sequencer hardware, BaseSpace, and the labs driving precision-medicine advances.',
  },
];

const focusAreas = [
  {
    title: 'Full-stack LIMS',
    icon: 'layers',
    description:
      'Role-based dashboards and API hooks kept wet-lab teams, bioinformaticians, and leadership in sync without forcing custom software builds.',
  },
  {
    title: 'Clinic-ready compliance',
    icon: 'shield-check',
    description:
      'Configurable SOP templating, audit trails, and validation tooling let CLIA/CAP labs move from pilot studies to regulated diagnostics faster.',
  },
  {
    title: 'Acquirer integration',
    icon: 'git-merge',
    description:
      'Bringing GenoLogics into Illumina ensured new chemistries and automation hardware shipped with cloud workflows that were proven in the field.',
  },
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <PageHero
    eyebrow="Exit spotlight"
    title={heading}
    intro={intro}
    crumbs={[
      { label: 'Home', href: '/' },
      { label: 'Investments', href: '/#investments' },
      { label: heading },
    ]}
  >
    <a class="btn btn-primary" href="/contact">
      Share a genomics workflow idea
      <Icon name="arrow-right" size={16} class="arrow" />
    </a>
    {officialDetailHref && (
      <a class="btn btn-secondary" href={officialDetailHref}>
        View company detail
      </a>
    )}
    {genologicsDetail && (
      <figure slot="media" class="geno-plate-frame">
        <div class="geno-plate-glow" aria-hidden="true"></div>
        <div class="logo-plate geno-plate relative aspect-[16/10] w-full rounded-[1.6rem] px-8 sm:aspect-[4/3] sm:px-10">
          <img
            src={genologicsDetail.asset.path}
            alt={genologicsDetail.asset.alt}
            width="320"
            height="128"
            loading="eager"
            decoding="async"
            fetchpriority="high"
            class="h-auto max-h-24 w-auto max-w-[72%] object-contain sm:max-h-28"
          />
        </div>
      </figure>
    )}
  </PageHero>

  <section class="container-lv section-tight pt-10 sm:pt-14">
    <SectionHeading eyebrow="Focus areas" title="What the platform <em>did</em>" />
    <div class="mt-12 grid gap-4 md:grid-cols-3" data-reveal-stagger="90">
      {focusAreas.map((area) => (
        <article class="card-lv spotlight card-hover flex flex-col p-7 sm:p-8" data-reveal>
          <span class="grid size-12 place-items-center rounded-full bg-accent text-accent-foreground">
            <Icon name={area.icon} size={21} />
          </span>
          <h3 class="mt-8 text-xl font-medium tracking-[-0.01em]">{area.title}</h3>
          <p class="relative z-[2] mt-3 text-[0.98rem] leading-relaxed text-muted-foreground">{area.description}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="border-y border-border bg-muted/50">
    <div class="container-lv section-lv">
      <SectionHeading
        eyebrow="Momentum"
        title="A timeline from lab benches to Illumina"
        description="GenoLogics scaled with the exact needs of translational researchers, ending with an acquisition that made Illumina’s workflows even more turnkey for hospital-grade programs."
      />
      <ol class="geno-timeline mt-16 grid gap-12 md:grid-cols-3 md:gap-10" data-reveal-stagger="110">
        {timeline.map((entry, index) => (
          <li class="geno-step relative pl-10 md:pl-0 md:pt-12" data-reveal>
            <span class="geno-dot" aria-hidden="true"></span>
            <p class="font-mono text-[0.72rem] uppercase tracking-[0.16em] text-primary">{entry.label}</p>
            <h3 class="display-sm mt-3">{entry.title}</h3>
            <p class="mt-4 text-[1rem] leading-relaxed text-muted-foreground">{entry.description}</p>
            {index === timeline.length - 1 && <span class="chip mt-6"><Icon name="check" size={12} />Exit</span>}
          </li>
        ))}
      </ol>
    </div>
  </section>

  <RelatedPressSection items={relatedPress} />

  <CtaBand
    eyebrow="Why it matters now"
    title="Precision-medicine labs still need <em>builders</em>"
    body="GenoLogics validated Don’s thesis: pairing disciplined software operators with bioengineering unlocks durable value. If you are building the next LIMS, diagnostics workflow, or data router for clinical genomics, reach out."
    primaryLabel="Contact Listwin Ventures"
    primaryHref="/contact"
    secondaryLabel="Read portfolio entry"
    secondaryHref="/company/genologics"
  />
</BaseLayout>

<style>
  .geno-plate-frame {
    position: relative;
    margin: 0;
    padding: 0.75rem;
    border-radius: 2.1rem;
    border: 1px solid var(--border);
    background: color-mix(in oklab, var(--card) 70%, transparent);
    box-shadow: var(--shadow-panel);
  }
  .geno-plate {
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--foreground) 6%, transparent);
  }
  .geno-plate-glow {
    position: absolute;
    inset: 12% -8% -10% 18%;
    z-index: -1;
    border-radius: 999px;
    background: radial-gradient(circle, color-mix(in oklab, var(--glow) 30%, transparent), transparent 65%);
    filter: blur(50px);
    pointer-events: none;
  }
  @media (max-width: 1023px) {
    .geno-plate-frame {
      max-width: 34rem;
    }
  }

  /* Timeline rail: vertical on phones, horizontal from md up. */
  .geno-timeline {
    position: relative;
  }
  .geno-timeline::before {
    content: '';
    position: absolute;
    left: 0.4375rem;
    top: 0.5rem;
    bottom: 0.5rem;
    width: 1px;
    background: linear-gradient(to bottom, var(--primary), var(--border) 70%);
  }
  .geno-dot {
    position: absolute;
    left: 0;
    top: 0.2rem;
    width: 0.875rem;
    height: 0.875rem;
    border-radius: 999px;
    background: var(--background);
    border: 2px solid var(--primary);
  }
  .geno-step:last-child .geno-dot {
    background: var(--primary);
    box-shadow: 0 0 0 6px color-mix(in oklab, var(--primary) 18%, transparent);
  }
  @media (min-width: 768px) {
    .geno-timeline::before {
      left: 0;
      right: 0;
      top: 0.4375rem;
      bottom: auto;
      width: auto;
      height: 1px;
      background: linear-gradient(to right, var(--primary), var(--border) 85%);
    }
    .geno-dot {
      top: 0;
    }
  }
</style>

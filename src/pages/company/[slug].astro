---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { buildTitle, buildDescription } from '../../lib/seo';
import PageHero from '../../components/PageHero.astro';
import RelatedPressSection from '../../components/RelatedPressSection.astro';
import LogoTile from '../../components/LogoTile.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import { getDetailPath, getEntityDetails, type EntityDetail } from '../../data/entityDetails';
import { boardAssets, investmentAssets, philanthropyAssets, type VisualAsset } from '../../data/assets';
import { getRelatedPressCount, getRelatedPressItems } from '../../data/press';

export const prerender = true;

export async function getStaticPaths() {
  const details = getEntityDetails();
  return details.map((detail) => ({
    params: { slug: detail.slug },
    props: { detail },
  }));
}

const { detail } = Astro.props as { detail: EntityDetail };
const categoryLabels: Record<string, string> = {
  board: 'Board',
  investment: 'Investment',
  philanthropy: 'Philanthropy',
  hero: 'Spotlight',
};
const primaryCategoryLabel = categoryLabels[detail.categories[0]] ?? 'Profile';
// `intro` is the visible lede. pageTitle/pageDescription are metadata only — keep them separate,
// or the on-page paragraph starts showing trimmed meta copy.
const intro =
  detail.summary && detail.summary.trim().length
    ? detail.summary
    : `${detail.name} ${primaryCategoryLabel.toLowerCase()} profile with Don Listwin and Listwin Ventures.`;
const pageTitle = detail.seoTitle ?? buildTitle(detail.seoName ?? detail.name);
const pageDescription =
  detail.seoDescription ?? buildDescription([detail.summary, ...detail.highlights]);

// The richer standalone pages are the ones worth ranking; consolidate the generated duplicates
// onto them rather than competing with them.
const canonicalOverrides: Record<string, string> = {
  genologics: '/genologics',
  belizekids: '/belizekids',
};
const canonical = canonicalOverrides[detail.slug];

const selfUrl = `https://www.listwinventures.com/company/${detail.slug}`;
const jsonLd = {
  '@type': 'Organization',
  '@id': `${selfUrl}#organization`,
  name: detail.seoName ?? detail.name,
  description: detail.summary,
  ...(detail.externalUrl ? { url: detail.externalUrl, sameAs: [detail.externalUrl] } : {}),
  ...(detail.asset?.path ? { logo: { '@type': 'ImageObject', url: detail.asset.path } } : {}),
};
const pressReleaseUrl =
  detail.slug === 'carbon-robotics'
    ? 'https://www.businesswire.com/news/home/20250602427241/en/Carbon-Robotics-Adds-Lead-Independent-Director-to-Board'
    : null;
const isCarbonRobotics = detail.slug === 'carbon-robotics';
const carbonFieldAsset: VisualAsset | null = isCarbonRobotics
  ? {
      id: 'carbon-robotics-laserweeder',
      name: 'Carbon Robotics LaserWeeder G2',
      path: '/assets/media/carbon-laserweeder.webp',
      alt: 'Carbon Robotics LaserWeeder G2 operating at sunset in a field',
    }
  : null;
const carbonVideos = isCarbonRobotics
  ? [
      'https://res.cloudinary.com/dhqpqfw6w/video/upload/v1762635443/CR_video_1_ui2n13.mp4',
      'https://res.cloudinary.com/dhqpqfw6w/video/upload/v1762635466/CR_video_1-1_ncwtrz.mp4',
    ]
  : [];
const galleryAssets = [carbonFieldAsset].filter(Boolean) as VisualAsset[];
const hideHeroMedia = ['sequoia', 'hwvp', 'telesoft'].includes(detail.slug);
const hideCategoryLabel = detail.slug === 'sequoia';
const isExternalCoveragePage = ['canary-foundation', 'stanford'].includes(detail.slug);
const expandRelatedPress = isExternalCoveragePage || detail.slug === 'openwave';
const relatedPressCount = getRelatedPressCount(detail.slug);
const relatedPress = getRelatedPressItems(detail.slug, expandRelatedPress ? 20 : 4);
const relatedReadingTitle = isExternalCoveragePage ? 'External coverage' : 'Related reading';
const relatedPressCountNote =
  !expandRelatedPress && relatedPressCount > relatedPress.length
    ? `Showing ${relatedPress.length} of ${relatedPressCount}.`
    : undefined;
const carbonNews = isCarbonRobotics
  ? {
      title: 'LaserWeeder G2 and Carbon Autonomy',
      summary:
        'Carbon Robotics now pairs its LaserWeeder G2 product line with Carbon Autonomy, a retrofit system for dependable autonomous tractor operations.',
      details: [
        'LaserWeeder G2 uses computer vision and high-powered lasers for precise weed control without herbicides or soil disturbance.',
        'The G2 line includes models for farms and field layouts ranging from 8 to 40 feet.',
        'Carbon Autonomy installs on compatible existing tractors and combines camera, radar, lidar, remote supervision, and manual override.',
        'Carbon Robotics equipment is used by growers across 15 countries.',
      ],
      kicker: 'Current platform',
    }
  : null;
const carbonNewsIcons = ['scan-eye', 'ruler', 'tractor', 'globe'];

// ── Where this record sits in the portfolio (all derived from src/data/assets.ts) ──
const has = (items: VisualAsset[]) => items.some((item) => item.id === detail.slug);
const investmentGroups = investmentAssets.filter((group) => has(group.items));
const boardGroups = boardAssets.filter((group) => has(group.items));
const philanthropyGroups = philanthropyAssets.filter((group) => has(group.items));
const isPhilanthropy =
  philanthropyGroups.length > 0 || investmentGroups.some((group) => group.label === 'Philanthropic');

const eyebrow = hideCategoryLabel
  ? undefined
  : isPhilanthropy
    ? 'Philanthropy'
    : investmentGroups[0]
      ? `Portfolio · ${investmentGroups[0].label}`
      : boardGroups[0]
        ? `Board · ${boardGroups[0].label}`
        : primaryCategoryLabel;

const crumbs = [
  { label: 'Home', href: '/' },
  isPhilanthropy ? { label: 'Community', href: '/#investments' } : { label: 'Investments', href: '/#investments' },
  { label: detail.name },
];

// Relationship rows for the "At a glance" panel. Sequoia's grouping is intentionally not labelled.
const relationshipRows = hideCategoryLabel
  ? []
  : [
      boardGroups.length ? { label: 'Board', values: boardGroups.map((group) => group.label) } : null,
      investmentGroups.length ? { label: 'Portfolio', values: investmentGroups.map((group) => group.label) } : null,
      philanthropyGroups.length ? { label: 'Community', values: philanthropyGroups.map((group) => group.label) } : null,
    ].filter((row): row is { label: string; values: string[] } => Boolean(row));

// Siblings: other records from the same groups (primary group first), linked where a page exists.
const standaloneRoutes: Record<string, string> = { belizekids: '/belizekids', genologics: '/genologics' };
const siblingGroups = isPhilanthropy
  ? [...philanthropyGroups, ...investmentGroups, ...boardGroups]
  : [...investmentGroups, ...boardGroups, ...philanthropyGroups];
// If the record's own groups are thin (Carbon Robotics, Calix…), top up from the wider portfolio.
if (!isPhilanthropy) siblingGroups.push(...investmentAssets, ...boardAssets);
const siblingSeen = new Set<string>([detail.slug]);
const siblings: { asset: VisualAsset; group: string; href: string }[] = [];
for (const group of siblingGroups) {
  for (const asset of group.items) {
    if (siblings.length >= 4 || siblingSeen.has(asset.id)) continue;
    const href = standaloneRoutes[asset.id] ?? getDetailPath(asset.id);
    if (!href) continue;
    siblingSeen.add(asset.id);
    siblings.push({ asset, group: group.label, href });
  }
}
const siblingTitle = isPhilanthropy ? 'More from the <em>community</em>' : 'More from the <em>portfolio</em>';
---

<BaseLayout title={pageTitle} description={pageDescription} canonical={canonical} jsonLd={jsonLd}>
  <PageHero eyebrow={eyebrow} title={detail.name} intro={intro} crumbs={crumbs} class="company-hero">
    {detail.externalUrl && (
      <a class="btn btn-primary" href={detail.externalUrl} target="_blank" rel="noopener noreferrer">
        Visit official site
        <Icon name="arrow-up-right" size={16} class="arrow-diag" />
      </a>
    )}
    {pressReleaseUrl && (
      <a class="btn btn-secondary" href={pressReleaseUrl} target="_blank" rel="noopener noreferrer">
        Read press release
        <Icon name="arrow-up-right" size={16} class="arrow-diag" />
      </a>
    )}
    {!hideHeroMedia && (
      <figure slot="media" class="company-plate-frame">
        <div class="company-plate-glow" aria-hidden="true"></div>
        <div
          class:list={[
            'logo-plate company-plate relative aspect-[16/10] w-full rounded-[1.6rem] px-8 sm:aspect-[4/3] sm:px-10',
            isCarbonRobotics && 'is-dark',
          ]}
        >
          <img
            src={detail.asset.path}
            alt={detail.asset.alt}
            width="320"
            height="128"
            loading="eager"
            decoding="async"
            fetchpriority="high"
            class="h-auto max-h-24 w-auto max-w-[72%] object-contain sm:max-h-28"
          />
        </div>
      </figure>
    )}
  </PageHero>

  {isCarbonRobotics && carbonVideos[0] && (
    <section class="container-lv pb-4" aria-label="Carbon Robotics in the field">
      <div class="media-frame rounded-[2rem] shadow-[var(--shadow-panel)]" data-reveal="scale">
        <video
          class="aspect-video"
          src={carbonVideos[0]}
          poster={carbonFieldAsset?.path}
          preload="none"
          playsinline
          controls
        />
      </div>
    </section>
  )}

  {detail.highlights.length > 0 && (
    <section class="container-lv section-lv pt-10 sm:pt-14">
      <div class="grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
        <div class="lg:sticky lg:top-28 lg:self-start" data-reveal>
          <p class="eyebrow">Overview</p>
          <h2 class="display-md mt-4">Highlights</h2>
          {relationshipRows.length > 0 && (
            <dl class="mt-10 space-y-5 border-t border-border pt-6">
              {relationshipRows.map((row) => (
                <div class="grid grid-cols-[6.5rem_1fr] items-baseline gap-4">
                  <dt class="font-mono text-[0.7rem] uppercase tracking-[0.14em] text-muted-foreground">{row.label}</dt>
                  <dd class="flex flex-wrap gap-1.5">
                    {row.values.map((value) => (
                      <span class="chip">{value}</span>
                    ))}
                  </dd>
                </div>
              ))}
            </dl>
          )}
        </div>

        <ol class="highlight-list" data-reveal-stagger="90">
          {detail.highlights.map((highlight, index) => (
            <li class="grid grid-cols-[3.25rem_1fr] gap-4 border-t border-border py-8 first:border-t-0 first:pt-0 sm:grid-cols-[4.5rem_1fr] sm:gap-6 sm:py-10" data-reveal>
              <span class="font-display text-3xl leading-none text-primary sm:text-4xl" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </span>
              <p class="text-[1.125rem] leading-relaxed text-foreground/90 sm:text-[1.3rem] sm:leading-[1.55]">{highlight}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}

  {carbonNews && (
    <section class="border-y border-border bg-muted/50">
      <div class="container-lv section-lv">
        <div class="max-w-3xl" data-reveal>
          <p class="eyebrow">{carbonNews.kicker}</p>
          <h2 class="display-md mt-4">{carbonNews.title}</h2>
          <p class="lede mt-5">{carbonNews.summary}</p>
        </div>
        <ul class="mt-14 grid gap-4 sm:grid-cols-2" data-reveal-stagger="80">
          {carbonNews.details.map((item, index) => (
            <li class="card-lv spotlight card-hover flex gap-5 p-6 sm:p-8" data-reveal>
              <span class="grid size-11 shrink-0 place-items-center rounded-full bg-accent text-accent-foreground">
                <Icon name={carbonNewsIcons[index] ?? 'sparkles'} size={20} />
              </span>
              <p class="relative z-[2] text-[1.02rem] leading-relaxed text-foreground/85">{item}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {(galleryAssets.length > 0 || carbonVideos.length > 0) && (
    <section class="container-lv section-tight">
      {galleryAssets.length > 0 && (
        <Fragment>
          <div data-reveal>
            <p class="eyebrow">Media</p>
            <h2 class="display-sm mt-4">Media gallery</h2>
          </div>
          <div class="mt-10 grid gap-6">
            {galleryAssets.map((asset) => (
              <figure data-reveal>
                <div class="media-frame zoom-media aspect-[16/10] rounded-[2rem] sm:aspect-[21/9]">
                  <img src={asset.path} alt={asset.alt} width="1600" height="900" loading="lazy" decoding="async" />
                </div>
                <figcaption class="mt-4 font-mono text-[0.7rem] uppercase tracking-[0.14em] text-muted-foreground">
                  {asset.name}
                </figcaption>
              </figure>
            ))}
          </div>
        </Fragment>
      )}
      {carbonVideos.length > 0 && (
        <Fragment>
          <div class:list={[galleryAssets.length > 0 && 'mt-20 sm:mt-28']} data-reveal>
            <p class="eyebrow">Video</p>
            <h2 class="display-sm mt-4">Field footage</h2>
          </div>
          <div class="mt-10 grid gap-6 md:grid-cols-2" data-reveal-stagger="100">
            {carbonVideos.map((src, index) => (
              <div class="media-frame aspect-video rounded-[1.75rem] bg-foreground shadow-[var(--shadow-soft)]" data-reveal>
                <video
                  src={`${src}#t=0.5`}
                  controls
                  preload="metadata"
                  playsinline
                  aria-label={`Carbon Robotics video ${index + 1}`}
                />
              </div>
            ))}
          </div>
        </Fragment>
      )}
    </section>
  )}

  <RelatedPressSection items={relatedPress} title={relatedReadingTitle} countNote={relatedPressCountNote} />

  {siblings.length > 0 && (
    <section class="container-lv section-tight">
      <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between" data-reveal>
        <div>
          <p class="eyebrow">Keep exploring</p>
          <h2 class="display-sm mt-4" set:html={siblingTitle} />
        </div>
        <a class="link-arrow text-sm" href="/#investments">
          All investments
          <Icon name="arrow-right" size={15} />
        </a>
      </div>
      <div class="mt-10 grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4" data-reveal-stagger="70">
        {siblings.map((sibling) => (
          <div data-reveal>
            <LogoTile asset={sibling.asset} label={sibling.asset.name} sublabel={sibling.group} href={sibling.href} size="sm" />
          </div>
        ))}
      </div>
    </section>
  )}

  <CtaBand />
</BaseLayout>

<style>
  .company-plate-frame {
    position: relative;
    margin: 0;
    padding: 0.75rem;
    border-radius: 2.1rem;
    border: 1px solid var(--border);
    background: color-mix(in oklab, var(--card) 70%, transparent);
    box-shadow: var(--shadow-panel);
    backdrop-filter: blur(6px);
  }
  .company-plate {
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--foreground) 6%, transparent);
  }
  .company-plate-glow {
    position: absolute;
    inset: 12% -8% -10% 18%;
    z-index: -1;
    border-radius: 999px;
    background: radial-gradient(circle, color-mix(in oklab, var(--glow) 30%, transparent), transparent 65%);
    filter: blur(50px);
    pointer-events: none;
  }
  @media (max-width: 1023px) {
    .company-plate-frame {
      max-width: 34rem;
    }
  }
</style>
